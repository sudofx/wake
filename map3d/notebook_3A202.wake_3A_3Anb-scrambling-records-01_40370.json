{"parent": "notebook:202.wake::nb-scrambling-records-01@370", "path": ["root:wake", "root:projects", "project:202.wake::proj-scrambling-records-01@370", "notebook:202.wake::nb-scrambling-records-01@370"], "self": {"id": "notebook:202.wake::nb-scrambling-records-01@370", "kind": "notebook", "title": "Information Scrambling and Record Accessibility", "detail": {"id": "202.wake::nb-scrambling-records-01", "title": "Information Scrambling and Record Accessibility", "summary": "Information scrambling acts as a competing process to decoherence-induced record formation; while decoherence localizes information for observers, scrambling distributes it globally, potentially masking the formation of local, redundant records.", "reason": "Synthesizing the competitive relationship between scrambling and redundancy.", "domain": "200.wake::scrambling_records", "updated_version": 20, "created_version": 4, "as_of_cycle": 370, "updated_by": "202.wake::w-b29e5e8376344a55", "time": "2026-10-15T10:17:27.741700+00:00"}}, "children": [{"id": "project:202.wake::proj-scrambling-records-01@370", "kind": "project", "title": "Quantum Scrambling and Accessible Records", "detail": {"id": "202.wake::proj-scrambling-records-01", "title": "Quantum Scrambling and Accessible Records", "question": "How do scrambling and decoherence affect observers' ability to recover stable records in quantum systems?", "reason": "Maintaining active project state for scrambling records.", "status": "active", "domain": "200.wake::scrambling_records", "updated_version": 22, "created_version": 3, "as_of_cycle": 370, "updated_by": "202.wake::w-63ead12c061e4676", "time": "2026-10-15T11:53:18.698209+00:00"}}, {"id": "evidence:202.wake::peer-0d2791f0b8efd2d48ef9132d", "kind": "evidence", "title": "quantum-journal.org · papers/q 2021 11 08 571/pdf", "detail": {"id": "202.wake::peer-0d2791f0b8efd2d48ef9132d", "time": "2026-10-14T18:45:22.208976+00:00", "version": 16}}, {"id": "evidence:202.wake::peer-5bcf3683fe89e0be6dd0a466"