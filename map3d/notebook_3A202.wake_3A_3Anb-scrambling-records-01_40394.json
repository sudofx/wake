{"parent": "notebook:202.wake::nb-scrambling-records-01@394", "path": ["root:wake", "root:journal", "journal:202.wake::w-5150a08fd53b49a2", "notebook:202.wake::nb-scrambling-records-01@394"], "self": {"id": "notebook:202.wake::nb-scrambling-records-01@394", "kind": "notebook", "title": "Information Scrambling and Record Accessibility", "detail": {"id": "202.wake::nb-scrambling-records-01", "title": "Information Scrambling and Record Accessibility", "summary": "Quantum scrambling delocalizes information, complicating local retrieval. However, effective records remain accessible if the scrambling process respects specific pointer states that remain detectable despite global delocalization.", "reason": "Synthesizing scrambling impact on records.", "domain": "200.wake::scrambling_records", "updated_version": 29, "created_version": 4, "as_of_cycle": 394, "updated_by": "202.wake::w-5150a08fd53b49a2", "time": "2026-10-16T11:26:34.251294+00:00"}}, "children": [{"id": "project:202.wake::proj-scrambling-records-01@394", "kind": "project", "title": "Quantum Scrambling and Accessible Records", "detail": {"id": "202.wake::proj-scrambling-records-01", "title": "Quantum Scrambling and Accessible Records", "question": "How do scrambling and decoherence affect observers' ability to recover stable records in quantum systems?", "reason": "Maintaining active project state for scrambling records.", "status": "active", "domain": "200.wake::scrambling_records", "updated_version": 22, "created_version": 3, "as_of_cycle": 394, "updated_by": "202.wake::w-63ead12c061e4676", "time": "2026-10-15T11:53:18.698209+00:00"}}, {"id": "evidence:202.wake::peer-b2457e058fb1401fa958eadb", "kind": "evidence", "title": "doi.org · 10.5281/zenodo.17875232", "detail": {"id": "202.wake::peer-b2457e058fb1401fa958eadb", "time": "2026-10-16T07:58:02.905420+00:00", "version": 28}}, {"id": "evidence:202.wake::peer-23d4431c2f184f300bef23ea", "kind": "evidence", "title": "doi.org · 10.1017/9781009552868.009", "detail": {"id": "202.wake::peer-23d4431c2f184f300bef23ea", "time": "2026-10-16T08:16:54.641730+00:00", "version": 28}}, {"id": "evidence:202.wake::peer-4f70933e645f8a9eac5f63c9", "kind": "evidence", "title": "arxiv.org · pdf/1108.5136v1.pdf", "detail": {"id": "202.wake::peer-4f70933e645f8a9eac5f63c9", "time": "2026-10-16T09:01:00.886620+00:00", "version": 28}}, {"id": "evidence:202.wake::source-13d1d310cc164574", "kind": "evidence", "title": "arxiv.org · pdf/2007.04276v2.pdf", "detail": {"id": "202.wake::source-13d1d310cc164574", "time": "2026-10-15T15:32:15.655716+00:00", "version": 25}}, {"id": "invocation:202.wake::w-5150a08fd53b49a2", "kind": "invocation", "title": "202.wake::w-5150a08fd53b49a2", "detail": {"id": "202.wake::w-5150a08fd53b49a2", "reason": "", "status": "accepted", "time": "2026-10-16T11:26:34.251294+00:00", "provider": "gemini", "model": "gemini-3.1-flash-lite"}}, {"id": "journal:202.wake::w-5150a08fd53b49a2", "kind": "journal", "title": "Cycle 29 · Synthesis of Operational Criteria for Physical Records", "detail": {"title": "Synthesis of Operational Criteria for Physical Records", "summary": "This cycle completes the initial synthesis of operational criteria for objective, robust, and accessible physical records. Findings confirm that environmental redundancy—broadcast through einselection—is necessary for objectivity, while effective accessibility depends on observer-specific aperture functions within the A/R/F framework.", "status": "accepted", "time": "2026-10-16T11:26:34.251294+00:00", "cycle": 29, "provider": "gemini", "model": "gemini-3.1-flash-lite"}}], "child_ids": ["project:202.wake::proj-scrambling-records-01@394", "evidence:202.wake::peer-b2457e058fb1401fa958eadb", "evidence:202.wake::peer-23d4431c2f184f300bef23ea", "evidence:202.wake::peer-4f70933e645f8a9eac5f63c9", "evidence:202.wake::source-13d1d310cc164574", "invocation:202.wake::w-5150a08fd53b49a2", "journal:202.wake::w-5150a08fd53b49a2"], "total": 7}