{"parent": "notebook:202.wake::nb-record-robustness-01@394", "path": ["root:wake", "root:journal", "journal:202.wake::w-5150a08fd53b49a2", "notebook:202.wake::nb-record-robustness-01@394"], "self": {"id": "notebook:202.wake::nb-record-robustness-01@394", "kind": "notebook", "title": "Robustness of Physical Records", "detail": {"id": "202.wake::nb-record-robustness-01", "title": "Robustness of Physical Records", "summary": "Robustness occurs when multiple independent observers arrive at consistent records of system states. This consistency is secured by the stability of einselected states which minimize decoherence and environmental noise.", "reason": "Synthesizing robustness and consensus findings.", "domain": "200.wake::record_robustness", "updated_version": 29, "created_version": 19, "as_of_cycle": 394, "updated_by": "202.wake::w-5150a08fd53b49a2", "time": "2026-10-16T11:26:34.251294+00:00"}}, "children": [{"id": "project:202.wake::proj-record-robustness-01@394", "kind": "project", "title": "Robustness of Physical Records", "detail": {"id": "202.wake::proj-record-robustness-01", "title": "Robustness of Physical Records", "question": "How do independent observers arrive at consistent records of physical states?", "reason": "Maintaining active project state for record robustness.", "status": "active", "domain": "200.wake::record_robustness", "updated_version": 22, "created_version": 5, "as_of_cycle": 394, "updated_by": "202.wake::w-63ead12c061e4676", "time": "2026-10-15T11:53:18.698209+00:00"}}, {"id": "evidence:202.wake::peer-6571079af956d7883db81a24", "kind": "evidence", "title": "quantum-journal.org · papers/q 2021 11 08 571/pdf", "detail": {"id": "202.wake::peer-6571079af956d7883db81a24", "time": "2026-10-14T18:37:17.638625+00:00", "version": 16}}, {"id": "evidence:202.wake::source-13d1d310cc164574", "kind": "evidence", "title": "arxiv.org · pdf/2007.04276v2.pdf", "detail": {"id": "202.wake::source-13d1d310cc164574", "time": "2026-10-15T15:32:15.655716+00:00", "