egation.", "revision": 1, "schema": "wake-experiment-protocol@1", "seeds": [1024, 2048], "source": "def experiment(inputs):\n    # Simulate N agents with varying historical accuracy\n    # Agent confidence is proxy for accuracy\n    # Compare individual judgment vs majority consensus accuracy\n    import random\n    results = []\n    for _ in range(inputs['trials']):\n        agents = [{'acc': random.uniform(0.5, 0.9), 'conf': random.uniform(0.5, 1.0)} for _ in range(10)]\n        consensus = sum(1 for a in agents if a['acc'] > 0.6) / 10 > 0.5\n        independent = max(agents, key=lambda x: x['conf'])\n        results.append({'independent_better': independent['acc'] > (0.6 if consensus else 0.4)})\n    return results", "stop": "Completion of 100 trials across varied accuracy distributions.", "success": "Observation of clear accuracy gain in independent judgment when agent confidence exceeds consensus variance."}, "id": "exp-judgment-threshold-001", "project": "proj-judgment-consensus-001", "type": "experiment"}], "base_version": 104, "summary": "This cycle focuses on experimental validation of the independent judgment threshold hypothesis within the consensus modeling project. Foundational commitments remain open for subsequent cycles due to topic-enforcement constraints.", "title": "Research on Independent Consensus Thresholds"}, "provider_requests_sent": 1, "result_hash": "78ec60fa5d1c8c125326fd49f001a8de08ba618c9e203ae44a19397cb1619ccf"}, "prev_hash": "6c4b774221a2960dccedd2f1787f7d735f3860a53c8c28fdae955e98cae667b8", "hash": "4a24828afa28f6c70d14b45e547a93547d479ab657162f4aec13150f36491763"}, "projection_only": true, "projection_id": "102.wake::4a24828afa28f6c70d14b45e547a93547d479ab657162f4aec13150f36491763"}]}