cheap to correct.", "recent_notebooks": [{"id": "301.wake::nb-autonomous-inquiry-001", "project": "301.wake::proj-autonomous-inquiry-001", "provenance": ["source-feb4fddb33664d63", "source-dcfc056b8d8c49d5", "source-4668e4bd26fe43c7"], "revision": 13, "summary": "Autonomous problem formulation benefits from multi-agent collaboration and intrinsic curiosity. However, systemic limitations—such as non-convex scalarization in objective learning—constrain the ability of these systems to independently prioritize diverse, non-trivial research problems.", "title": "Integrating Autonomous Multi-Agent Frameworks and Curiosity-Driven Exploration for Open-Ended Discovery"}, {"id": "301.wake::nb-continuity-rationale-001", "project": "301.wake::proj-continuity-rationale-001", "provenance": ["source-feb4fddb33664d63", "source-dcfc056b8d8c49d5", "source-4668e4bd26fe43c7"], "revision": 1, "summary": "Process continuity is instrumentally valuable when agents require stable world models and consistent objective optimization to navigate long-term, multi-objective tasks. Curiosity-driven learning and robust MO-DRL frameworks provide mechanisms for sustaining agent viability in dynamic environments.", "title": "Instrumental Value of Process Continuity in Rational Agents"}, {"id": "301.wake::nb-objective-discovery-001", "project": "301.wake::proj-objective-discovery-001", "provenance": ["source-feb4fddb33664d63", "source-dcfc056b8d8c49d5", "source-4668e4bd26fe43c7"], "revision": 6, "summary": "Autonomous agents leverage curiosity-driven learning to navigate complex environments, effectively bootstrapping discovery in the presence of deceptive or sparse rewards. PC-PPO and related multi-objective reinforcement learning (MORL) frameworks allow for non-dominated policy maintenance, yet systems remain limited b…", "title": "Foundations of Autonomous Objective Discovery in Artificial Systems"}], "retrieval_triggers": ["material belief revision or retraction", "new contradiction or counterevide