tments": [], "principle": "Keep exact receipts externally; carry the smallest useful abstraction that stays cheap to correct.", "recent_notebooks": [{"id": "100.wake::notebook-assumption-challenge-01", "project": "100.wake::proj-assumption-challenge-01", "provenance": ["source-70c4dff141dd489d", "source-aff9418ec71a41c3", "source-e71511d6819f400b"], "revision": 4, "summary": "By integrating the governance module's immutability as a fixed constraint, WAKE identifies its own boundary conditions as testable assumptions. Governance stability is maintained through the verifiable rejection of model-authored proposal transitions.", "title": "Systematic Assumption Testing in Self-Correcting Models"}, {"id": "100.wake::notebook-f1c16003-obedience-failure", "project": "100.wake::proj-obedience-failure-01", "provenance": ["source-f1c16003c47b4e8f", "source-b1a16f9e7285493e", "source-cbeddd6778fc48b1"], "revision": 2, "summary": "Synthesizing multiple source works, obedience failures in autonomous and intelligent systems are shown to stem from structural delegation and governance gaps rather than isolated machine autonomy.", "title": "Delegation, Governance, and Obedience Failures in Complex Systems"}, {"id": "100.wake::notebook-judgment-consensus-01", "project": "100.wake::proj-judgment-consensus-01", "provenance": ["source-70c4dff141dd489d", "source-aff9418ec71a41c3", "source-e71511d6819f400b"], "revision": 2, "summary": "Consensus reliability is contingent upon the epistemic independence of constituent evidence sources. When external expert consensus exhibits correlated error structures, independent analysis provides a superior epistemic foundation.", "title": "Independent Judgment versus Consensus Reliability"}, {"id": "100.wake::notebook-wake-architecture-synthesis", "project": "100.wake::proj-wake-self-study-01", "provenance": ["source-70c4dff141dd489d", "source-f102687cd1ea46f5"], "revision": 7, "summary": "WAKE✳︎ ensures accountability by strictly coupling future resear