ry"}, {"id": "nb-continuity-rationale-001", "project": "proj-continuity-rationale-001", "provenance": ["source-feb4fddb33664d63", "source-dcfc056b8d8c49d5", "source-4668e4bd26fe43c7"], "revision": 1, "summary": "Process continuity is instrumentally valuable when agents require stable world models and consistent objective optimization to navigate long-term, multi-objective tasks. Curiosity-driven learning and robust MO-DRL frameworks provide mechanisms for sustaining agent viability in dynamic environments.", "title": "Instrumental Value of Process Continuity in Rational Agents"}, {"id": "nb-objective-discovery-001", "project": "proj-objective-discovery-001", "provenance": ["source-feb4fddb33664d63", "source-dcfc056b8d8c49d5", "source-4668e4bd26fe43c7"], "revision": 6, "summary": "Autonomous agents leverage curiosity-driven learning to navigate complex environments, effectively bootstrapping discovery in the presence of deceptive or sparse rewards. PC-PPO and related multi-objective reinforcement learning (MORL) frameworks allow for non-dominated policy maintenance, yet systems remain limited b…", "title": "Foundations of Autonomous Objective Discovery in Artificial Systems"}], "retrieval_triggers": ["material belief revision or retraction", "new contradiction or counterevidence", "high-consequence decision", "request for justification", "sign that an excerpt may hide a material distinction"]}}, "prev_hash": "566009fa91e1e92e72329c04a12efdd3d04b254c7c5d1cb6da795d59ce5e53fa", "hash": "016629a5a68d49d639935590c02057cae161044a32fe9000bb87340913510b87"}, "projection_only": true, "projection_id": "301.wake::016629a5a68d49d639935590c02057cae161044a32fe9000bb87340913510b87"}, {"seq": 3486, "time": "2026-10-26T20:20:46.953921+00:00", "kind": "provider_attempt_started", "payload": {"attempt": {"http_status": null, "model": "gemini-3.1-flash-lite", "provider_input_chars": 45320, "provider_input_hash": "17bb59147262f5f106931ef5821e0891325c7d50857786796a3082c21c4bdfdc", "result"