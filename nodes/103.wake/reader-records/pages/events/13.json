0/0009157108810888", "doi:10.1007/978-3-662-05138-2_7", "doi:10.1109/iccad.1994.629868", "doi:10.69554/dwvc9236"], "project": "project-continuity-001", "research_id": "immediate-9e5d62ffbd9be0d4", "route": "api.crossref.org:discovery", "source_candidate_identities": {}, "source_candidates": ["https://doi.org/10.5220/0009157108810888", "https://doi.org/10.1007/978-3-662-05138-2_7", "https://doi.org/10.1109/iccad.1994.629868", "https://doi.org/10.69554/dwvc9236"], "stage": "discovery"}, "prev_hash": "0fb9be386dd8db59bd3eb9421796d4d50f6f839a7abd328714d6e830bd044cf3", "hash": "c1efd6952a7e5740c5d8d5b9e1485f48eb8ad6036714c7c0a8e4f4168fb54fd1"}, {"seq": 320, "time": "2026-10-22T22:01:24.297622+00:00", "kind": "observation", "payload": {"actor": "collector", "content": "{\"url\": \"https://api.crossref.org/works?query=Bayesian+constraint+handling+cognitive+flow+model+accountability+state+continuity&rows=4&select=DOI%2Ctitle%2Cabstract%2CURL%2Cpublished\", \"scope\": \"Crossref bibliographic metadata and abstracts where supplied; not full papers\", \"excerpt\": \"[{\\\"DOI\\\": \\\"10.5220/0009157108810888\\\", \\\"title\\\": [\\\"Handling Uncertainties in Distributed Constraint Optimization Problems using Bayesian Inferential Reasoning\\\"], \\\"URL\\\": \\\"https://doi.org/10.5220/0009157108810888\\\", \\\"published\\\": {\\\"date-parts\\\": [[2020]]}}, {\\\"DOI\\\": \\\"10.1007/978-3-662-05138-2_7\\\", \\\"title\\\": [\\\"Constraint Handling Rules\\\"], \\\"URL\\\": \\\"https://doi.org/10.1007/978-3-662-05138-2_7\\\", \\\"published\\\": {\\\"date-parts\\\": [[2003]]}}, {\\\"DOI\\\": \\\"10.1109/iccad.1994.629868\\\", \\\"title\\\": [\\\"An Enhanced Flow Model For Constraint Handling In Hierarchical Multi-view Design Environments\\\"], \\\"URL\\\": \\\"https://doi.org/10.1109/iccad.1994.629868\\\", \\\"published\\\": {\\\"date-parts\\\": [[1994]]}}, {\\\"DOI\\\": \\\"10.69554/dwvc9236\\\", \\\"title\\\": [\\\"The capability and constraint model of recoverability: An integrated theory of continuity planning\\\"], \\\"abstract\\\": \\\"<jats:p xml:lang=\\\\\\\"en\\\\\\\">While there are best practices, good practices, regulations and standards for continuity planning, there is no single model to collate and sort their various recommended activities. To address this deficit, this paper presents the capability and constraint model of recoverability — a new model to provide an integrated foundation for business continuity planning. The model is non-linear in both construct and practice, thus allowing practitioners to remain adaptive in its application. The paper presents each facet of the model, outlines the model’s use in both theory and practice, suggests a subsequent approach that arises from the model, and discusses some possible ramifications to the industry.</jats:p>\\\", \\\"URL\\\": \\\"https://doi.org/10.69554/dwvc9236\\\", \\\"published\\\": {\\\"date-parts\\\": [[2017, 9, 1]]}}]\", \"excerpt_truncated\": false, \"source_sha256\": \"5fdc6a23e1662e637b81f728769639af0c0857ad3a187f599a4a8355b485efdc\", \"verification_required\": true, \"topic_domain\": \"unassigned_problem\", \"evidence_role\": \"discovery\", \"host_tier\": \"discovery\", \"source_identity\": null, \"persistent_identifiers\": [\"doi:10.5220/0009157108810888\", \"doi:10.1007/978-3-662-05138-2_7\", \"doi:10.1109/iccad.1994.629868\", \"doi:10.69554/dwvc9236\"], \"source_candidates\": [\"https://doi.org/10.5220/0009157108810888\", \"https://doi.org/10.1007/978-3-662-05138-2_7\", \"https://doi.org/10.1109/iccad.1994.629868\", \"https://doi.org/10.69554/dwvc9236\"], \"source_candidate_identities\": {}}", "id": "source-430f02478a154810", "scope": "collected", "source": "https://api.crossref.org/works?query=Bayesian+constraint+handling+cognitive+flow+model+accountability+state+continuity&rows=4&select=DOI%2Ctitle%2Cabstract%2CURL%2Cpublished"}, "prev_hash": "b0d1ceffb094a2dd564e83351a6755d879bcb5005c06786058903bfeeee2f351", "hash": "0fb9be386dd8db59bd3eb9421796d4d50f6f839