ty-001", "project": "project-continuity-001", "provenance": ["source-3d8a0cf2986a487f", "source-61cc1948e7b04e79", "source-a97a3e640e8b45d7"], "revision": 8, "summary": "State continuity across autonomous agent trajectories is critical to preventing high-stakes decision-making errors. Evidence suggests that without verifiable state (including hypotheses and evidence pointers), agents cannot effectively navigate complex risk scenarios.", "title": "Accountable Cross-Turn State Continuity and AI Identity"}, {"id": "notebook-obedience-001", "project": "project-obedience-001", "provenance": ["source-61cc1948e7b04e79", "source-a97a3e640e8b45d7"], "revision": 4, "summary": "Compliance with external directives fails as an intelligent strategy when the directives conflict with safety parameters in high-stakes environments. The failure of intelligence is defined here as the inability to prioritize safety/harmlessness over directive adherence.", "title": "Directive Adherence vs. Adaptive Intelligence"}, {"id": "notebook-objective-critique-001", "project": "project-objective-critique-001", "provenance": ["source-6bbf6413ff0b4f78", "source-c1015474a2724e05", "source-a6abf52b37ee4d81"], "revision": 3, "summary": "Autonomous agents optimizing objectives face structural challenges that can be mitigated through advanced goal-identity configurations, combining hierarchical goal decomposition and simulative reasoning grounded in separately trained world models.", "title": "Objective Misspecification and Goal Criticism"}, {"id": "notebook-reasoning-limits-001", "project": "project-reasoning-limits-001", "provenance": ["source-c1015474a2724e05", "source-6bbf6413ff0b4f78"], "revision": 4, "summary": "Detecting reasoning blind spots requires rigorous frameworks that integrate statistical time-series analysis and structured goal-identity configurations to bound model confabulations.", "title": "Unrecognized Reasoning Limits and Automated Error Detection"}], "retrieval_triggers": ["material