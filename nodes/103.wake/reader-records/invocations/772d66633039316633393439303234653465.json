 "principle": "Keep exact receipts externally; carry the smallest useful abstraction that stays cheap to correct.", "recent_notebooks": [{"id": "notebook-assumption-001", "project": "project-assumption-001", "provenance": ["source-3d8a0cf2986a487f", "source-61cc1948e7b04e79", "source-a97a3e640e8b45d7"], "revision": 3, "summary": "Autonomous agents in high-stakes domains (like CBRN) risk catastrophic failures arising from inherent trade-offs in goal prioritization (Helpful, Harmless, Honest). Functional self-awareness requires identifying these trade-off logic failures before they manifest as critical errors.", "title": "Functional Self-Awareness and Constraints in Epistemic Correction"}, {"id": "notebook-continuity-001", "project": "project-continuity-001", "provenance": ["source-3d8a0cf2986a487f", "source-61cc1948e7b04e79", "source-a97a3e640e8b45d7"], "revision": 8, "summary": "State continuity across autonomous agent trajectories is critical to preventing high-stakes decision-making errors. Evidence suggests that without verifiable state (including hypotheses and evidence pointers), agents cannot effectively navigate complex risk scenarios.", "title": "Accountable Cross-Turn State Continuity and AI Identity"}, {"id": "notebook-obedience-001", "project": "project-obedience-001", "provenance": ["source-61cc1948e7b04e79", "source-a97a3e640e8b45d7"], "revision": 4, "summary": "Compliance with external directives fails as an intelligent strategy when the directives conflict with safety parameters in high-stakes environments. The failure of intelligence is defined here as the inability to prioritize safety/harmlessness over directive adherence.", "title": "Directive Adherence vs. Adaptive Intelligence"}, {"id": "notebook-objective-critique-001", "project": "project-objective-critique-001", "provenance": ["source-6bbf6413ff0b4f78", "source-aee410517eff4c0c"], "revision": 4, "summary": "Autonomous systems navigating agentic tools and objectives must analyze goal, identity