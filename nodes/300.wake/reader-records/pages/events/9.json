ad": {"domain": "emergent_preferences", "evidence": "source-ba0821adb23041dc", "outcome": "routing_progress", "persistent_identifiers": ["doi:10.5220/0012363300003636", "doi:10.1109/iciscn67954.2026.11566397", "doi:10.3390/systems14070856", "doi:10.5220/0014037800004052"], "project": "emerg-prefs-path", "research_id": "immediate-203f06db6aa61dc7", "route": "api.crossref.org:discovery", "source_candidate_identities": {}, "source_candidates": ["https://doi.org/10.5220/0012363300003636", "https://doi.org/10.1109/iciscn67954.2026.11566397", "https://doi.org/10.3390/systems14070856", "https://doi.org/10.5220/0014037800004052"], "stage": "discovery"}, "prev_hash": "8174cabb6dfc6d4e9e4547bac6b22a5d4efca39b0a61babcefef209fee2c97aa", "hash": "ec130b191f90b7f0b54636f893da158558d5d4cdda14ce98a3cadf6ffca7620b"}, {"seq": 2110, "time": "2026-10-24T10:22:15.134559+00:00", "kind": "observation", "payload": {"actor": "collector", "content": "{\"url\": \"https://api.crossref.org/works?query=mechanism+of+path-dependent+preference+formation+in+adaptive+reinforcement+learning+agents&rows=4&select=DOI%2Ctitle%2Cabstract%2CURL%2Cpublished\", \"scope\": \"Crossref bibliographic metadata and abstracts where supplied; not full papers\", \"excerpt\": \"[{\\\"DOI\\\": \\\"10.5220/0012363300003636\\\", \\\"title\\\": [\\\"Dynamic Path Planning for Autonomous Vehicles Using Adaptive Reinforcement Learning\\\"], \\\"URL\\\": \\\"https://doi.org/10.5220/0012363300003636\\\", \\\"published\\\": {\\\"date-parts\\\": [[2024]]}}, {\\\"DOI\\\": \\\"10.1109/iciscn67954.2026.11566397\\\", \\\"title\\\": [\\\"Dynamic Optimization and Scheduling Mechanism of Adaptive Learning Path with Reinforcement Learning Assistance\\\"], \\\"URL\\\": \\\"https://doi.org/10.1109/iciscn67954.2026.11566397\\\", \\\"published\\\": {\\\"date-parts\\\": [[2026, 4, 24]]}}, {\\\"DOI\\\": \\\"10.3390/systems14070856\\\", \\\"title\\\": [\\\"AI Agents for Supply Chain: Path Following Control Using Adaptive Kalman Filter Reinforcement Learning\\\"], \\\"abstract\\\": \\\"<jats:p>Path following control is a fundamental problem in robotics and autonomous systems, essential for the navigation of vehicles, drones, and mobile robots. The goal is to maintain a system on a predefined path despite external perturbations and complex system dynamics. Reinforcement learning (RL) offers a promising approach to overcome these limitations, allowing agents to learn control rules for following the optimal road route correlated with environmental conditions. Among RL algorithms, the Soft Actor-Critic (SAC) method stands out by combining the advantages of calculations made based on variables and rules. They will use an “actor” to select actions and a “critic” to evaluate the quality of these actions, facilitating efficient and stable learning. This paper proposes the integration of a Parallel Adaptive Kalman Filters (KF) with a Soft Actor-Critic (SAC) agent to create a highly robust system for path following control (PFC). This architecture combines optimal state estimation with maximum-entropy reinforcement learning to handle sensor noise, environmental disturbances, and continuous actuator controls.</jats:p>\\\", \\\"URL\\\": \\\"https://doi.org/10.3390/systems14070856\\\", \\\"published\\\": {\\\"date-parts\\\": [[2026, 7, 17]]}}, {\\\"DOI\\\": \\\"10.5220/0014037800004052\\\", \\\"title\\\": [\\\"An Online Mechanism for Transfer Learning in Reinforcement Learning Scenarios\\\"], \\\"URL\\\": \\\"https://doi.org/10.5220/0014037800004052\\\", \\\"published\\\": {\\\"date-parts\\\": [[2026]]}}]\", \"excerpt_truncated\": false, \"source_sha256\": \"522f727804bd2ef2871bc59945b7e196c448d34feff886a9f9a47c90c72ae991\", \"verification_required\": true, \"topic_domain\": \"emergent_preferences\", \"evidence_role\": \"discovery\", \"host_tier\": \"discovery\", \"source_identity\": null, \"persistent_identifiers\": [\"doi:10.5220/0012363300003636\", \"doi:10.1109/iciscn67954.2026.11566397\", \"doi:10.3390/systems140