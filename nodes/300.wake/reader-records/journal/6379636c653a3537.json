enges.", "supersedes": 2, "uncertainty": "Exact overhead bounds and failure modes under deep multi-tier recursion remain unmeasured."}, "id": "hyp-complexity-growth-001", "project": "unprompted-complexity-growth-study-001", "type": "hypothesis"}, {"definition": {"budget": {"provider_calls": 0, "seconds": 20}, "evaluator": {"id": "sort-correctness@1"}, "hypothesis": "hyp-complexity-growth-001", "inputs": {"cases_per_seed": 4, "length": 8, "magnitude": 100}, "instrument": "python", "method": "Implement a multi-tier recursive task sorting protocol in Python to measure correctness and structural complexity across hierarchical task splits.", "revision": 3, "schema": "wake-experiment-protocol@1", "seeds": [13, 71, 43], "source": "def experiment(inputs):\n    trials = inputs.get('trials', [])\n    results = []\n    def multi_tier_sort(vals):\n        if len(vals) <= 1:\n            return vals\n        mid = len(vals) // 2\n        left = multi_tier_sort(vals[:mid])\n        right = multi_tier_sort(vals[mid:])\n        return sorted(left + right)\n    for trial in trials:\n        vals = list(trial.get('values', []))\n        results.append(multi_tier_sort(vals))\n    return results", "stop": "Completion of multi-tier delegation evaluation across all seeds.", "success": "All trials return perfectly sorted arrays matching exact sorting correctness."}, "id": "exp-complexity-growth-sorting-003", "project": "unprompted-complexity-growth-study-001", "type": "experiment"}], "base_version": 56, "summary": "This proposal advances the active unprompted complexity growth study by submitting a revised hypothesis and experiment to test multi-tier delegation and scaling behavior in computational processes.", "title": "Expanding Complexity Growth Protocols"}, "provider_requests_sent": 1, "result_hash": "740025a78ce988e8bcea8fb016924683e6ead74eb3eee74870e85a6d9c0ddf35"}, "prev_hash": "2d892520e68eb0a21acc3671bcd4c24a7773a3b06a77c65d4cb41e54b5eeca57", "hash": "4f2941886f09d3d694e1d9d48139