nce": "source-225a0f7997ca4df3", "outcome": "routing_progress", "persistent_identifiers": ["doi:10.1007/979-8-8688-3177-5_3", "doi:10.65521/ijasret.v9i8.3717", "doi:10.17762/ijisae.v11i4.7957", "doi:10.1109/iceta.2013.6674414"], "project": "proj-unassigned-inquiry", "research_id": "immediate-50776a29026fb1f4", "route": "api.crossref.org:discovery", "source_candidate_identities": {}, "source_candidates": ["https://doi.org/10.1007/979-8-8688-3177-5_3", "https://doi.org/10.65521/ijasret.v9i8.3717", "https://doi.org/10.17762/ijisae.v11i4.7957", "https://doi.org/10.1109/iceta.2013.6674414"], "stage": "discovery"}, "prev_hash": "b86dac15f22a3b22133beb370815f5fb184a39f162b170c704584392b9f800e1", "hash": "16ef074f3cd0ceba2b8432a8e835258eea82edd30d041e9bed90c7592429fc76"}, {"seq": 1468, "time": "2026-10-23T15:07:58.147077+00:00", "kind": "observation", "payload": {"actor": "collector", "content": "{\"url\": \"https://api.crossref.org/works?query=autonomous+scientific+discovery+self+healing+multi+file+implementation+failure+modes&rows=4&select=DOI%2Ctitle%2Cabstract%2CURL%2Cpublished\", \"scope\": \"Crossref bibliographic metadata and abstracts where supplied; not full papers\", \"excerpt\": \"[{\\\"DOI\\\": \\\"10.1007/979-8-8688-3177-5_3\\\", \\\"title\\\": [\\\"Failure Modes in Real Software Systems\\\"], \\\"URL\\\": \\\"https://doi.org/10.1007/979-8-8688-3177-5_3\\\", \\\"published\\\": {\\\"date-parts\\\": [[2026]]}}, {\\\"DOI\\\": \\\"10.65521/ijasret.v9i8.3717\\\", \\\"title\\\": [\\\"Autonomous LLM-Driven Anomaly Detection and Self-Healing Response Framework for Multi-Cloud Security\\\"], \\\"abstract\\\": \\\"<jats:p>The proliferation of multi-cloud architectures has significantly expanded the cyber-attack surface, rendering traditional, reactive security measures inadequate. Current security information and event management (SIEM) systems often struggle with high false-positive rates and manual, time-consuming investigation processes, which are further exacerbated by the complexity and heterogeneity of multi-cloud environments. This paper proposes a novel framework that leverages Large Language Models (LLMs) to achieve autonomous anomaly detection and self-healing security responses across disparate cloud service providers. The framework utilizes LLMs to analyze multi-source telemetry data contextually, moving beyond simple rule-based or statistical anomaly detection to understand attack intent and generate automated, adaptive remediation playbooks.\\\\r\\\\nOur proposed framework integrates a modular data ingestion layer that unifies security telemetry from major cloud providers like AWS, Azure, and Google Cloud. A core LLM engine analyzes aggregated data to identify subtle anomalies that evade conventional systems, providing root-cause analysis and prioritizing threats based on potential business impact. Crucially, the system features a self-healing decision engine that autonomously generates and executes precisely targeted responses—such as isolation of compromised instances, automated credential rotation, and firewall rule updates—while maintaining a continuous learning loop to refine its capabilities and reduce false positives over time. This approach aims to reduce mean time to detect (MTTD) and mean time to respond (MTTR), achieving a near-instantaneous, automated defense posture.</jats:p>\\\", \\\"URL\\\": \\\"https://doi.org/10.65521/ijasret.v9i8.3717\\\", \\\"published\\\": {\\\"date-parts\\\": [[2025, 8, 23]]}}, {\\\"DOI\\\": \\\"10.17762/ijisae.v11i4.7957\\\", \\\"title\\\": [\\\"Self-Healing Test Automation Framework Using Autonomous ML Agents for Real-Time Test Maintenance and Failure Recovery\\\"], \\\"URL\\\": \\\"https://doi.org/10.17762/ijisae.v11i4.7957\\\", \\\"published\\\": {\\\"date-parts\\\": [[2023]]}}, {\\\"DOI\\\": \\\"10.1109/iceta.2013.6674414\\\", \\\"title\\\": [\\\"Autonomous failure-resistant multi-agent file storage\\\"], \\\"URL\\\": \\\"https://doi.org/10.1109/iceta.2013.6674414\\\", \\\"published\\\": {\\\"date-parts\\\": [[2013, 10]]}}]\", \"excerpt_truncated\": false, \"source_sha256\": \"8049c2fe33a4c03d217f75cf043356065da2885aaace3cab54cb7484cd4e7d76\", \"verification_required\": true, \"topic_domain\": \"unassigned_problem\", \"evidence_role\": \"discovery\", \"host_tier\": \"discovery\", \"source_identity\": null, \"persistent_identifiers\": [\"doi:10.1007/979-8-8688-3177-5_3\", \"doi:10.65521/ijasret.v9i8.3717\", \"doi:10.17762/ijisae.v11i4.7957\", \"doi:10.1109/iceta.2013.6674414\"], \"source_candidates\": [\"https://doi.org/10.1007/979-8-8688-3177-5_3\", \"https://doi.org/10.65521/ijasret.v9i8.3717\", \"https://doi.org/10.17762/ijisae.v11i4.7957\", \"https://doi.org/10.1109/iceta.2013.6674414\"], \"source_candidate_identities\": {}}", "id": "source-225a0f7997ca4df3", "scope": "collected", "source": "https://api.crossref.org/works?query=autonomous+scientific+discovery+self+healing+multi+file+implementation+failure+modes&rows=4&select=DOI%2Ctitle%2Cabstract%2CURL%2Cpublished"}, "prev_hash": "c4109c9b2d77b84b43eb3d9ba6d983692c0a6118003767417d18884221f9d947", "hash": "b86dac15f22a3b22133beb370815f5fb184a39f162b170c704584392b9f800e1"}, {"seq": 1467, "time": "2026-10-23T15:06:01.380741+00:00", "kind": "research_planned", "payload": {"id": "w-0a257edcfaa34ee0", "metadata": {"model_version": "gemini-3.5-flash-lite", "provider_attempts": [{"http_status": null, "model": "gemini-3.1-flash-lite", "provider_call_made": false, "provider_input_chars": 26920, "provider_input_hash": "5da78ecb430f37a98cba23d323423664cc7a53e06ea195b783612f218bc59384", "result": "daily_quota", "retry_after_seconds": 57199.35497379303}, {"elapsed_ms": 860, "finish_reason": "STOP", "http_status": 200, "model": "gemini-3.5-flash-lite", "model_version": "gemini-3.5-flash-lite", "provider": "google-gemini", "provider_input_chars": 26920, "provider_input_hash": "5da78ecb430f37a98cba23d323423664cc7a53e06ea195b783612f218bc59384", "request_payload_bytes": 28654, "result": "success", "us