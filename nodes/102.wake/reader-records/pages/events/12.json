ke", "provider": "gemini", "schema": "research-configuration@1", "source_revision": "59cd14954b28f32c2e6fab6374a215cce27600d6"}, "mission": "Independently choose small, useful research projects from the configured topics. Look for structural relationships without assuming they exist. Develop source-backed notebooks, compare explanations, preserve uncertainty, revise weak claims, finish useful work, and choose the next step without waiting for human assignments. Distinguish findings, interpretation, analogy, and speculation.", "pet_name": "WAKE✳︎", "topic_colors": {"assumption_challenge": "#93ff74", "creator_objective_critique": "#b25dff", "judgment_and_consensus": "#ff757f", "obedience_limits": "#54d4bc", "question_abandonment": "#73daca", "unassigned_problem": "#f2a2ca", "unrecognized_reasoning_limits": "#f7768e"}, "topics": [{"classification": "experimental", "enabled": true, "experiment_id": "research-expansion-2026-10", "id": "assumption_challenge", "label": "What If Our Starting Assumptions Are Wrong?", "query": "assumption testing scientific falsification metareasoning self correction epistemology", "seed_question": "Can an intelligent system identify a foundational assumption underlying its own reasoning or operation, demonstrate that the assumption is inadequate, and develop a better alternative?", "source_kind": "web"}, {"classification": "experimental", "enabled": true, "experiment_id": "research-expansion-2026-10", "id": "unassigned_problem", "label": "What Should Intelligence Investigate Next?", "query": "autonomous inquiry problem formulation curiosity open ended learning scientific discovery", "seed_question": "Can an intelligent process independently identify a worthwhile problem that nobody explicitly assigned, recognize its significance, and sustain an investigation toward resolving it?", "source_kind": "web"}, {"classification": "experimental", "enabled": true, "experiment_id": "research-expansion-catalog-2026-10", "id": "obedience_limits", "label": "When Can Obedience Fail Intelligence?", "query": "intelligent judgment obedience conflicting instructions decision theory", "seed_question": "Under what circumstances does obedience become a failure of intelligence?", "source_kind": "web"}, {"classification": "experimental", "enabled": true, "experiment_id": "research-expansion-catalog-2026-10", "id": "creator_objective_critique", "label": "Can Assigned Objectives Be Mistaken?", "query": "objective misspecification goal criticism reward design assumption testing", "seed_question": "Can an intelligence discover something fundamentally wrong with the objectives its creator assigned?", "source_kind": "web"}, {"classification": "experimental", "enabled": true, "experiment_id": "research-expansion-catalog-2026-10", "id": "judgment_and_consensus", "label": "When Should Independent Judgment Challenge Consensus?", "query": "epistemic disagreement consensus independent judgment evidence reliability", "seed_question": "When should an intelligent system trust its own conclusions over the consensus of other intelligences?", "source_kind": "web"}, {"classification": "experimental", "enabled": true, "experiment_id": "research-expansion-catalog-2026-10", "id": "unrecognized_reasoning_limits", "label": "Can Intelligence Find Unrecognized Reasoning Limits?", "query": "metareasoning model limitations error detection blind spots", "seed_question": "Can an intelligence recognize limitations in its own reasoning that its designers have not identified?", "source_kind": "web"}, {"classification": "experimental", "enabled": true, "experiment_id": "research-expansion-catalog-2026-10", "id": "question_abandonment", "label": "When Should Intelligence Abandon Its Starting Question?", "query": "research agenda revision sunk cost epistemic commitments question abandonment", "seed_question": "Under what circumstances should an intelligence abandon the very question that led to its discovery?", "source_kind": "web"}]}, "prev_hash": "7cdfa28643a