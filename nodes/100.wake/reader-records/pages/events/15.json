{"head": "12138edbe21c973d0f782bb90d3e98517168dc53999b3fb81110404497803c2d", "collection": "events", "rows": [{"seq": 956, "time": "2026-11-04T16:05:23.047745+00:00", "kind": "observation", "payload": {"actor": "collector", "content": "{\"url\": \"https://europepmc.org/articles/PMC13298660?pdf=render\", \"error\": \"HTTPError\", \"scope\": \"fetch failed; no evidence obtained\"}", "id": "source-a08d7e9347f54c7c", "scope": "failed", "source": "https://europepmc.org/articles/PMC13298660?pdf=render"}, "prev_hash": "36b690324e317741becfdae6f6fc11714faab5d3c4abb3280d8e87d300fa5c40", "hash": "bed81e719ccb59a2fc294c5f8d5a2f982ba980b985c9998507867d6f4d19ebc2"}, {"seq": 955, "time": "2026-11-04T16:05:12.284096+00:00", "kind": "acquisition_assessed", "payload": {"domain": "judgment_and_consensus", "evidence": "source-2bbbabb4048845ae", "outcome": "routing_progress", "persistent_identifiers": ["doi:10.3389/fpsyt.2026.1815025", "doi:10.1007/s42113-024-00196-7", "doi:10.1007/s10433-025-00891-9", "pmc:PMC13713289", "pmc:PMC13298660", "pmc:PMC12586272"], "project": "p-epistemic-disagreement", "research_id": "immediate-c8ebef33c332f99f", "route": "www.ebi.ac.uk:discovery", "source_candidate_identities": {}, "source_candidates": ["https://europepmc.org/articles/PMC13298660?pdf=render", "https://doi.org/10.1007/s42113-024-00196-7", "https://doi.org/10.1007/s10433-025-00891-9", "https://europepmc.org/articles/PMC12586272", "https://europepmc.org/articles/PMC12586272?pdf=render"], "stage": "discovery"}, "prev_hash": "978461d3022f7fdc070d4fdb8285e2373364aa33e192af1e56d91f7636b24f00", "hash": "36b690324e317741becfdae6f6fc11714faab5d3c4abb3280d8e87d300fa5c40"}, {"seq": 954, "time": "2026-11-04T16:05:04.292215+00:00", "kind": "observation", "payload": {"actor": "collector", "content": "{\"url\": \"https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=Bayesian+epistemology+formal+models+of+group+consensus+vs+individual+evidence+weight&format=json&resultType=core&pageSize=4\", \"scope\": \"Europe PMC search metadata, abstracts and full-text links; discovery only\", \"excerpt\": \"[{\\\"title\\\": \\\"Projecting the real through active inference: a unified model of reality construction from neuronal dynamics to social consensus &lt;i&gt;a neuroscientific framework for psychopathology&lt;/i&gt;.\\\", \\\"abstract\\\": \\\"How does the brain transform a chaotic stream of sensory signals into a stable, shared experience of reality? This theoretical paper proposes that the brain does not passively receive the world, but actively projects it - it continuously generates predictions about sensory inputs and updates its internal model when predictions fail, a process formally described by the free energy principle and active inference. We argue that this process can be understood through an analogy with quantum decoherence - the collapse of multiple possibilities into a single actuality. By integrating insights from this analogy with active inference, we show how the brain resolves sensory uncertainty into a coherent projection of reality. A central question we address is whether projecting reality changes it. We argue that it does: a strong, coherent projection reduces uncertainty, while a weak or fragmented one amplifies prediction errors, and a distorted one - diverging from social consensus - leads to alternative realities that resist correction. This projection operates in discrete, rhythmic cycles governed by brain waves and is fine-tuned by neurochemicals that determine how much we \\\\\\\"trust\\\\\\\" our predictions versus new sensory data. The Default Mode Network - the brain's inner \\\\\\\"sea\\\\\\\" of self-awareness, memories, and context - acts as a central hub that integrates and updates these projections. Crucially, individual projections are stabilized into a shared, \\\\\\\"solid\\\\\\\" reality through social interaction, language, and culture - a process we call collective active inference. Within this framework, psychiatric disorders are understood as disorders of projection - distortions in how the brain generates and stabilizes its model of reality. This perspective reverses the traditional explanatory gradient: psychopathology is not merely a sensory or chemical problem, but a fundamental disruption of the brain's capacity to project a coherent world. This unifying framework offers a new foundation for both pharmacological and psychotherapeutic interventions, grounding them in a common computational logic.\\\", \\\"doi\\\": \\\"10.3389/fpsyt.2026.1815025\\\", \\\"pmid\\\": \\\"42952554\\\", \\\"pmcid\\\": \\\"PMC13713289\\\", \\\"source\\\": \\\"MED\\\", \\\"fullTextUrlList\\\": {\\\"fullTextUrl\\\": [{\\\"availability\\\": \\\"Subscription\\n\\n[... bounded source excerpt ...]\\n\\nilability\\\": \\\"Free\\\", \\\"availabilityCode\\\": \\\"F\\\", \\\"documentStyle\\\": \\\"pdf\\\", \\\"site\\\": \\\"Europe_PMC\\\", \\\"url\\\": \\\"https://europepmc.org/articles/PMC13298660?pdf=render\\\"}, {\\\"availability\\\": \\\"Free\\\", \\\"availabilityCode\\\": \\\"F\\\", \\\"documentStyle\\\": \\\"doi\\\", \\\"site\\\": \\\"DOI\\\", \\\"url\\\": \\\"https://doi.org/10.1007/s42113-024-00196-7\\\"}]}}, {\\\"title\\\": \\\"Challenges and opportunities of psychological aging research.\\\", \\\"abstract\\\": \\\"The scientific study of psychological aging is very challenging due to the complex, multidimensional, multi-directional, and highly variable nature of change processes observed in adulthood and old age. Psychological aging encompasses phenomena that require interdisciplinary efforts to be understood. Recent advancements in technology (e.g., wearable devices, apps offering digital metrics, multimodal data collection, artificial intelligence, and big data algorithms) reconfigure the epistemology of behavioral and social sciences but can, if properly applied and analyzed, enhance our understanding of the mechanisms behind age-related within-person change. As researchers in the field of psychological aging, we must continually train in various domains and keep abreast of new methodologies, with the aim of advancing theoretical perspectives on aging. Collaborative, open, and cumulative research efforts are key to developing our knowledge of psychological aging. Additionally, as privileged observers of aging mechanisms and processes, we bear the responsibility to challenge stereotypes surrounding aging and help educate professionals in related fields who work with older populations. There is also a critical need for accurate scientific information about psychological aging to inform public and social policies, making our contributions even more valuable. This paper explores some of these challenges of psychological aging research and the opportunities they present.\\\", \\\"doi\\\": \\\"10.1007/s10433-025-00891-9\\\", \\\"pmid\\\": \\\"41186748\\\", \\\"pmcid\\\": \\\"PMC12586272\\\", \\\"source\\\": \\\"MED\\\", \\\"fullTextUrlList\\\": {\\\"fullTextUrl\\\": [{\\\"availability\\\": \\\"Subscription required\\\", \\\"availabilityCode\\\": \\\"S\\\", \\\"documentStyle\\\": \\\"doi\\\", \\\"site\\\": \\\"DOI\\\", \\\"url\\\": \\\"https://doi.org/10.1007/s10433-025-00891-9\\\"}, {\\\"availability\\\": \\\"Open access\\\", \\\"availabilityCode\\\": \\\"OA\\\", \\\"documentStyle\\\": \\\"html\\\", \\\"site\\\": \\\"Europe_PMC\\\", \\\"url\\\": \\\"https://europepmc.org/articles/PMC12586272\\\"}, {\\\"availability\\\": \\\"Open access\\\", \\\"availabilityCode\\\": \\\"OA\\\", \\\"documentStyle\\\": \\\"pdf\\\", \\\"site\\\": \\\"Europe_PMC\\\", \\\"url\\\": \\\"https://europepmc.org/articles/PMC12586272?pdf=render\\\"}]}}]\", \"excerpt_truncated\": true, \"source_sha256\": \"75b7736e45df8cb0019ddacc3fd3b38d58e2a8cc671b1db4440a518fdd0bec23\", \"verification_required\": true, \"topic_domain\": \"judgment_and_consensus\", \"evidence_role\": \"discovery\", \"host_tier\": \"discovery\", \"source_identity\": null, \"persistent_identifiers\": [\"doi:10.3389/fpsyt.2026.1