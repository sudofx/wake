urce_candidates": ["https://doi.org/10.1609/socs.v12i1.18572", "https://doi.org/10.7551/mitpress/8069.003.0013", "https://doi.org/10.7551/mitpress/8069.003.0025", "https://doi.org/10.7551/mitpress/9780262014809.003.0009"], "stage": "discovery"}, "prev_hash": "7adf55385b523dd190f380ebeb37fe9fe1f9bc7c4269c1cc3e77ce6ce9d5df02", "hash": "51a76702ed1bd813bd5898362398026480a1c428b6057206bcccb45adcf1e4c3"}, {"seq": 859, "time": "2026-10-23T07:26:10.642844+00:00", "kind": "observation", "payload": {"actor": "collector", "content": "{\"url\": \"https://api.crossref.org/works?query=theoretical+frameworks+for+metareasoning-partitioning+between+planning%2C+execution%2C+and+self-correction&rows=4&select=DOI%2Ctitle%2Cabstract%2CURL%2Cpublished\", \"scope\": \"Crossref bibliographic metadata and abstracts where supplied; not full papers\", \"excerpt\": \"[{\\\"DOI\\\": \\\"10.1609/socs.v12i1.18572\\\", \\\"title\\\": [\\\"Metareasoning for Interleaved Planning and Execution\\\"], \\\"abstract\\\": \\\"<jats:p>Agents that plan and act in the real world must deal with the fact that time passes as they are planning. In the presence of tight deadlines, there may be insufficient time to complete the search for a plan before it is time to act.\\\\nOne can gain additional time to search by starting to act before a complete plan is found, incurring the risk of making incorrect action choices.\\\\nThis tradeoff between opportunity and risk,\\\\ninherent in interleaving planning and\\\\nexecution, is a non-trivial metareasoning problem addressed in this paper.</jats:p>\\\", \\\"URL\\\": \\\"https://doi.org/10.1609/socs.v12i1.18572\\\", \\\"published\\\": {\\\"date-parts\\\": [[2021, 7, 21]]}}, {\\\"DOI\\\": \\\"10.7551/mitpress/8069.003.0013\\\", \\\"title\\\": [\\\"Metareasoning, Monitoring, and Self-Explanation\\\"], \\\"URL\\\": \\\"https://doi.org/10.7551/mitpress/8069.003.0013\\\", \\\"published\\\": {\\\"date-parts\\\": [[2011, 3, 18]]}}, {\\\"DOI\\\": \\\"10.7551/mitpress/8069.003.0025\\\", \\\"title\\\": [\\\"Anthropomorphic Self-Models for Metareasoning Agents\\\"], \\\"URL\\\": \\\"https://doi.org/10.7551/mitpress/8069.003.0025\\\", \\\"published\\\": {\\\"date-parts\\\": [[2011, 3, 18]]}}, {\\\"DOI\\\": \\\"10.7551/mitpress/9780262014809.003.0009\\\", \\\"title\\\": [\\\"Metareasoning, Monitoring, and Self-Explanation\\\"], \\\"URL\\\": \\\"https://doi.org/10.7551/mitpress/9780262014809.003.0009\\\", \\\"published\\\": {\\\"date-parts\\\": [[2011, 3, 18]]}}]\", \"excerpt_truncated\": false, \"source_sha256\": \"da3cd89f72fd67abf44c1343f168c541e0153b961cbb47a6d546bae365be2eeb\", \"verification_required\": true, \"topic_domain\": \"assumption_challenge\", \"evidence_role\": \"discovery\", \"host_tier\": \"discovery\", \"source_identity\": null, \"persistent_identifiers\": [\"doi:10.1609/socs.v12i1.18572\", \"doi:10.7551/mitpress/8069.003.0013\", \"doi:10.7551/mitpress/8069.003.0025\", \"doi:10.7551/mitpress/9780262014809.003.0009\"], \"source_candidates\": [\"https://doi.org/10.1609/socs.v12i1.18572\", \"https://doi.org/10.7551/mitpress/8069.003.0013\", \"https://doi.org/10.7551/mitpress/8069.003.0025\", \"https://doi.org/10.7551/mitpress/9780262014809.003.0009\"], \"source_candidate_identities\": {}}", "id": "source-d3178b11c2c7473d", "scope": "collected", "source": "https://api.crossref.org/works?query=theoretical+frameworks+for+metareasoning-partitioning+between+planning%2C+execution%2C+and+self-correction&rows=4&select=DOI%2Ctitle%2Cabstract%2CURL%2Cpublished"}, "prev_hash": "a85fe9517e969a51cd7c42ee4943c89424c500e832dea2f4746b29a207b381f7", "hash": "7adf55385b523dd190f380ebeb37fe9fe1f9bc7c4269c1cc3e77ce6ce9d5df02"}, {"seq": 858, "time": "2026-10-23T07:26:07.988851+00:00", "kind": "acquisition_assessed", "payload": {"domain": "assumption_challenge", "evidence": "source-17a66b8b48fe4f01", "outcome": "route_failure", "persistent_identifiers": [], "project": "proj-assumption-testing-epistemology", "research_id": "immediate-43206529cd26e210"