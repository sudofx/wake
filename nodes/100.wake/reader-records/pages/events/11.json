", "recent_notebooks": [{"id": "notebook-assumption-challenge-01", "project": "proj-assumption-challenge-01", "provenance": ["source-70c4dff141dd489d", "source-aff9418ec71a41c3", "source-e71511d6819f400b"], "revision": 4, "summary": "By integrating the governance module's immutability as a fixed constraint, WAKE identifies its own boundary conditions as testable assumptions. Governance stability is maintained through the verifiable rejection of model-authored proposal transitions.", "title": "Systematic Assumption Testing in Self-Correcting Models"}, {"id": "notebook-f1c16003-obedience-failure", "project": "proj-obedience-failure-01", "provenance": ["source-f1c16003c47b4e8f", "source-b1a16f9e7285493e", "source-cbeddd6778fc48b1"], "revision": 2, "summary": "Synthesizing multiple source works, obedience failures in autonomous and intelligent systems are shown to stem from structural delegation and governance gaps rather than isolated machine autonomy.", "title": "Delegation, Governance, and Obedience Failures in Complex Systems"}, {"id": "notebook-judgment-consensus-01", "project": "proj-judgment-consensus-01", "provenance": ["source-70c4dff141dd489d", "source-aff9418ec71a41c3", "source-e71511d6819f400b"], "revision": 2, "summary": "Consensus reliability is contingent upon the epistemic independence of constituent evidence sources. When external expert consensus exhibits correlated error structures, independent analysis provides a superior epistemic foundation.", "title": "Independent Judgment versus Consensus Reliability"}, {"id": "notebook-wake-architecture-synthesis", "project": "proj-wake-self-study-01", "provenance": ["source-70c4dff141dd489d", "source-aff9418ec71a41c3", "source-e71511d6819f400b"], "revision": 4, "summary": "Accountability is enforced via strict bifurcation of inquiry (model-driven) and governance (state-committed). This design prevents models from subverting the research record by ensuring that only valid, rule-compliant transitions are committed to durable history.", "title": "Mechanical Accountability in WAKE Architecture"}], "retrieval_triggers": ["material belief revision or retraction", "new contradiction or counterevidence", "high-consequence decision", "request for justification", "sign that an excerpt may hide a material distinction"]}}, "prev_hash": "432cb7ac5fe167b4f7bb385f55c6a53f072fd451e7d48254d7545bdf375cf475", "hash": "94e898d22c4f84fa583b157bb564ee1bb8cd43ae0bc49498afa2870d4becf0cc"}, {"seq": 3044, "time": "2026-10-29T03:13:37.516050+00:00", "kind": "observation", "payload": {"actor": "runtime", "content": "{\"base_version\":19,\"inherited_commitments\":[],\"invocation\":\"w-6ebfe52fabad4b98\",\"previous_head\":\"6bd5e6b8fb6897fc24ad1f7b6ce2c42cf0c74e24d1831df3bb0b8eaf3e9c7168\",\"process_id\":2616,\"scope\":\"Receipt proves state delivery to the provider boundary, not model comprehension.\"}", "id": "r-6ebfe52fabad4b98", "source": "runtime:continuity"}, "prev_hash": "6bd5e6b8fb6897fc24ad1f7b6ce2c42cf0c74e24d1831df3bb0b8eaf3e9c7168", "hash": "432cb7ac5fe167b4f7bb385f55c6a53f072fd451e7d48254d7545bdf375cf475"}, {"seq": 3043, "time": "2026-10-29T03:12:35.184581+00:00", "kind": "temporal_observed", "payload": {"cycle_distance": 0, "effective_elapsed_seconds": 881.575961, "effective_scale": 1.0, "effective_seconds_total": 140155.959399, "intervening_events": {"accepted": 0, "attention_assessed": 0, "failed": 0, "observation": 1, "rejected": 0, "research_collected": 0, "squirrel_assessed": 0, "total": 11}, "observed_at": "2026-10-29T03:12:31.503023+00:00", "previous_anchor_time": "2026-10-29T02:57:49.927062+00:00", "regime_id": "reg-df573bb03399f050", "wall_elapsed_seconds": 881.575961}, "prev_hash": "171cff9c1daeba57035f3d39420f9b1185c2045c805f5f9bb4a6cff0695ce2e6", "hash": "6bd5e6b8fb6897fc24ad1f7b6ce2c42cf0c74e24d1831df3bb0b8eaf3e9c7168"}, {"seq": 3042, "time": "2026-10-29T03:08:58.857084+00:00", "kind": "deferred", "payload": {"id": "w-db1bad0023a14231", "provider_attempts": [{"http_status": 