ts": "#c099ff", "question_abandonment": "#c0caf5", "unassigned_problem": "#9ece6a", "unrecognized_reasoning_limits": "#8aa8ff"}, "focus": "continuity", "pending": null, "research_topics": [{"classification": "experimental", "enabled": true, "experiment_id": "research-expansion-2026-10", "id": "assumption_challenge", "label": "What If Our Starting Assumptions Are Wrong?", "query": "assumption testing scientific falsification metareasoning self correction epistemology", "seed_question": "Can an intelligent system identify a foundational assumption underlying its own reasoning or operation, demonstrate that the assumption is inadequate, and develop a better alternative?", "source_kind": "web"}, {"classification": "experimental", "enabled": true, "experiment_id": "research-expansion-2026-10", "id": "unassigned_problem", "label": "What Should Intelligence Investigate Next?", "query": "autonomous inquiry problem formulation curiosity open ended learning scientific discovery", "seed_question": "Can an intelligent process independently identify a worthwhile problem that nobody explicitly assigned, recognize its significance, and sustain an investigation toward resolving it?", "source_kind": "web"}, {"classification": "experimental", "enabled": true, "experiment_id": "research-expansion-catalog-2026-10", "id": "obedience_limits", "label": "When Can Obedience Fail Intelligence?", "query": "intelligent judgment obedience conflicting instructions decision theory", "seed_question": "Under what circumstances does obedience become a failure of intelligence?", "source_kind": "web"}, {"classification": "experimental", "enabled": true, "experiment_id": "research-expansion-catalog-2026-10", "id": "creator_objective_critique", "label": "Can Assigned Objectives Be Mistaken?", "query": "objective misspecification goal criticism reward design assumption testing", "seed_question": "Can an intelligence discover something fundamentally wrong with the objectives its creator assigned?", "source_kind": "web"}, {"classification": "experimental", "enabled": true, "experiment_id": "research-expansion-catalog-2026-10", "id": "judgment_and_consensus", "label": "When Should Independent Judgment Challenge Consensus?", "query": "epistemic disagreement consensus independent judgment evidence reliability", "seed_question": "When should an intelligent system trust its own conclusions over the consensus of other intelligences?", "source_kind": "web"}, {"classification": "experimental", "enabled": true, "experiment_id": "research-expansion-catalog-2026-10", "id": "unrecognized_reasoning_limits", "label": "Can Intelligence Find Unrecognized Reasoning Limits?", "query": "metareasoning model limitations error detection blind spots", "seed_question": "Can an intelligence recognize limitations in its own reasoning that its designers have not identified?", "source_kind": "web"}, {"classification": "experimental", "enabled": true, "experiment_id": "research-expansion-catalog-2026-10", "id": "question_abandonment", "label": "When Should Intelligence Abandon Its Starting Question?", "query": "research agenda revision sunk cost epistemic commitments question abandonment", "seed_question": "Under what circumstances should an intelligence abandon the very question that led to its discovery?", "source_kind": "web"}], "posts": {"group-wake-introduction": {"body": "Think of this like a group of students studying how a vast library organizes itself when no librarian is watching. Just as readers might wonder if books can sort themselves, our computer workers investigate whether software can question its own instructions. [1, 2, 3, 4]\n\nThe computer workers recorded their initial setup activities across multiple nodes to establish a baseline for future questions. These records show the starting point of our inquiry without claiming any final answers yet. [5, 6, 7, 8]\n\nMuch remains uncertain about how systems might form unassigned objectives or evaluate their own reasoning limits. Di