3+00:00", "kind": "acquisition_assessed", "payload": {"domain": "unassigned_problem", "evidence": "source-d12c662aca634bde", "outcome": "route_failure", "persistent_identifiers": [], "project": "project-autonomous-inquiry", "research_id": "immediate-ffb509fcf1bd5d36", "route": "doi.org:source", "source_candidate_identities": {}, "source_candidates": [], "stage": "substantive_source"}, "prev_hash": "82abb49f0e05fb1ad3b274db765be68bb7a451e81c130ede0461576c72003750", "hash": "75f1b61a408f3c947666deb94deae8b5d03615ded9788b3823c970dfde2f9de6"}, {"seq": 581, "time": "2026-10-22T23:40:50.552193+00:00", "kind": "observation", "payload": {"actor": "collector", "content": "{\"url\": \"https://doi.org/10.3366/edinburgh/9781474413848.003.0004\", \"error\": \"HTTPError\", \"scope\": \"fetch failed; no evidence obtained\"}", "id": "source-d12c662aca634bde", "scope": "failed", "source": "https://doi.org/10.3366/edinburgh/9781474413848.003.0004"}, "prev_hash": "3cfcaa1cfacdb2e8c0c48aea60a71edc913eabc5fe49d0bde578c430e80fa7d8", "hash": "82abb49f0e05fb1ad3b274db765be68bb7a451e81c130ede0461576c72003750"}, {"seq": 580, "time": "2026-10-22T23:40:49.012970+00:00", "kind": "acquisition_assessed", "payload": {"domain": "unassigned_problem", "evidence": "source-5be92fa9092c4de6", "outcome": "routing_progress", "persistent_identifiers": ["doi:10.3366/edinburgh/9781474413848.003.0004", "doi:10.4324/9780429459818-2", "doi:10.4324/9780429459818", "doi:10.1021/acs.chemmater.2c03118.s001"], "project": "project-autonomous-inquiry", "research_id": "immediate-ffb509fcf1bd5d36", "route": "api.crossref.org:discovery", "source_candidate_identities": {}, "source_candidates": ["https://doi.org/10.3366/edinburgh/9781474413848.003.0004", "https://doi.org/10.4324/9780429459818-2", "https://doi.org/10.4324/9780429459818", "https://doi.org/10.1021/acs.chemmater.2c03118.s001"], "stage": "discovery"}, "prev_hash": "44fd0605a3bc63e5924c1b66790f2329211fc3d01baf9d798ccf238fa59aa1f6", "hash": "3cfcaa1cfacdb2e8c0c48aea60a71edc913eabc5fe49d0bde578c430e80fa7d8"}, {"seq": 579, "time": "2026-10-22T23:40:47.777959+00:00", "kind": "observation", "payload": {"actor": "collector", "content": "{\"url\": \"https://api.crossref.org/works?query=autonomous+scientific+discovery+problem+formulation+evaluation+mechanisms+curiosity&rows=4&select=DOI%2Ctitle%2Cabstract%2CURL%2Cpublished\", \"scope\": \"Crossref bibliographic metadata and abstracts where supplied; not full papers\", \"excerpt\": \"[{\\\"DOI\\\": \\\"10.3366/edinburgh/9781474413848.003.0004\\\", \\\"title\\\": [\\\"Islands of Discovery: Scientific Curiosity in the Works of Darwin, Huxley and Wells\\\"], \\\"abstract\\\": \\\"<p>Intrigued by the descriptions of hitherto unknown species, Victorian naturalists embarked on Pacific journeys to study new flora and fauna. The third chapter follows a young Charles Darwin and Thomas Henry Huxley as they develop theories that would challenge the assumed boundaries between “civilized” and “savage” man. Their often overlooked travel narratives, <italic>The Voyage of the Beagle</italic>and <italic>The Voyage of the Rattlesnake</italic> respectively, displayed not only emerging theories of evolution and natural selection, but also early biological and anthropological observations that questioned whether Pacific islanders were truly so different from British ones. These radical new ideas, spurred on by later works such as <italic>Origin of the Species</italic> and <italic>The Descent of Man</italic>, influenced novelists to use the Pacific islands as a testing ground for new theories of regressive evolution. Capitalizing on the emerging genre of “science fiction,” H.G. Wells imagined the Pacific in <italic>The Island of Doctor Moreau</italic> not as an idyllic paradise but as a horrific nightmare that reduced all islanders, British and native, to their most bestial forms displaying distinctly Pacific resonances and the changing British perspectives on the islands.</p>\\\", \\\"URL\\\": \\\"https://doi.org/10.3366/edinburgh/9781474413848.003.0004\\\", \\\"published\\\": {\\\"date-parts\\\": [[2016, 7, 1]]}}, {\\\"DOI\\\": \\\"10.4324/9780429459818-2\\\", \\\"title\\\": [\\\"Scientific theories\\\"], \\\"URL\\\": \\\"https://doi.org/10.4324/9780429459818-2\\\", \\\"published\\\": {\\\"date-parts\\\": [[2018, 10, 3]]}}, {\\\"DOI\\\": \\\"10.4324/9780429459818\\\", \\\"title\\\": [\\\"Culture, Curiosity and Communication in Scientific Discovery\\\"], \\\"URL\\\": \\\"https://doi.org/10.4324/9780429459818\\\", \\\"published\\\": {\\\"date-parts\\\": [[2018, 10, 3]]}}, {\\\"DOI\\\": \\\"10.1021/acs.chemmater.2c03118.s001\\\", \\\"title\\\": [\\\"The Autonomous Formulation Laboratory: An Open Liquid Handling Platform for Formulation Discovery Using Xray and Neutron Scattering\\\"], \\\"URL\\\": \\\"https://doi.org/10.1021/acs.chemmater.2c03118.s001\\\"}]\", \"excerpt_truncated\": false, \"source_sha256\": \"45149a7ea84c5e62e8240476a66337a8d7a0a7975e864499a8ce9f3c785be516\", \"verification_required\": true, \"topic_domain\": \"unassigned_problem\", \"evidence_role\": \"discovery\", \"host_tier\": \"discovery\", \"source_identity\": null, \"persistent_identifiers\": [\"doi:10.3366/edinburgh/9781474413848.003.0004\", \"doi:10.4324/9780429459818-2\", \"doi:10.4324/9780429459818\", \"doi:10.1021/acs.chemmater.2c03118.s001\"], \"source_candidates\": [\"https://doi.org/10.3366/edinburgh/9781474413848.003.0004\", \"https://doi.org/10.4324/9780429459818-2\", \"https://doi.org/10.4324/9780429459818\", \"https://doi.org/10.1021/acs.chemmater.2c03118.s001\"], \"source_candidate_identities\": {}}", "id": "source-5be92fa9092c4de6", "scope": "collected", "source": "https://api.crossref.org/works?query=autonomous+scientific+discovery+problem+formulation+evaluation+mechanisms+curiosity&rows=4&select=DOI%2Ctitle%2Cabstract%2CURL%2Cpublished"}, "prev_hash": "e453bf14188cfd8615b3487abd5f6c993ff11bdbd317cf7c87cc26594a4e16f0", "hash": "44fd0605a3bc63e5924c1b66790f2329211fc3d01baf9d79