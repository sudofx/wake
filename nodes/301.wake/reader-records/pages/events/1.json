ersistent_identifiers": [], "project": "proj-autonomous-inquiry-001", "research_id": "immediate-aa920e157a6c3d7a", "route": "doi.org:source", "source_candidate_identities": {}, "source_candidates": [], "stage": "substantive_source"}, "prev_hash": "4c3fa0d333f7ba202ea5836262cf2e9f724b3b3d53c14fa2e41607446e87e95d", "hash": "0c16fddea472604e24b826b11704e2435134e24cd92676687b3aeb023063f088"}, {"seq": 1542, "time": "2026-10-23T15:29:28.909455+00:00", "kind": "observation", "payload": {"actor": "collector", "content": "{\"url\": \"https://doi.org/10.1021/acs.chemmater.2c03118.s001\", \"error\": \"HTTPError\", \"scope\": \"fetch failed; no evidence obtained\"}", "id": "source-eee6c0e6586d4677", "scope": "failed", "source": "https://doi.org/10.1021/acs.chemmater.2c03118.s001"}, "prev_hash": "3d5e4f9c84bcc9848fb3eb1d9098127c896c6e384ba6c99f05245308576145cd", "hash": "4c3fa0d333f7ba202ea5836262cf2e9f724b3b3d53c14fa2e41607446e87e95d"}, {"seq": 1541, "time": "2026-10-23T15:29:25.171166+00:00", "kind": "acquisition_assessed", "payload": {"domain": "unassigned_problem", "evidence": "source-f4682fe8275a4a9e", "outcome": "routing_progress", "persistent_identifiers": ["doi:10.1021/acs.chemmater.2c03118.s001", "doi:10.2139/ssrn.7535040", "doi:10.4324/9780203130810-18", "doi:10.1002/9781118946084.part1"], "project": "proj-autonomous-inquiry-001", "research_id": "immediate-aa920e157a6c3d7a", "route": "api.crossref.org:discovery", "source_candidate_identities": {}, "source_candidates": ["https://doi.org/10.1021/acs.chemmater.2c03118.s001", "https://doi.org/10.2139/ssrn.7535040", "https://doi.org/10.4324/9780203130810-18", "https://doi.org/10.1002/9781118946084.part1"], "stage": "discovery"}, "prev_hash": "5dadf9cc65dbdeb94bd45df0ca4a43c792611ac5f98f2a6c6349866d48da04c6", "hash": "3d5e4f9c84bcc9848fb3eb1d9098127c896c6e384ba6c99f05245308576145cd"}, {"seq": 1540, "time": "2026-10-23T15:29:22.288565+00:00", "kind": "observation", "payload": {"actor": "collector", "content": "{\"url\": \"https://api.crossref.org/works?query=autonomous+problem+formulation+evaluation+open-ended+discovery+mechanisms&rows=4&select=DOI%2Ctitle%2Cabstract%2CURL%2Cpublished\", \"scope\": \"Crossref bibliographic metadata and abstracts where supplied; not full papers\", \"excerpt\": \"[{\\\"DOI\\\": \\\"10.1021/acs.chemmater.2c03118.s001\\\", \\\"title\\\": [\\\"The Autonomous Formulation Laboratory: An Open Liquid Handling Platform for Formulation Discovery Using Xray and Neutron Scattering\\\"], \\\"URL\\\": \\\"https://doi.org/10.1021/acs.chemmater.2c03118.s001\\\"}, {\\\"DOI\\\": \\\"10.2139/ssrn.7535040\\\", \\\"title\\\": [\\\"Must a Machine Feel before it can Ask? Functional Emotion and Problem Discovery in Open-ended Artificial Intelligence\\\"], \\\"abstract\\\": \\\"<jats:p>Artificial agents increasingly solve problems, even generating their own goals, once a task or success criterion is available, but what a self-improving system would need to expand its repertoire beyond problems humans have stated remains open. Recent proposals place a frontier before problems are formulated, yet a falsifiable mechanism for this stage, and an argument about whether it requires emotion, are underdeveloped. This paper argues in two stages. First, problem discovery is defined relative to a budget-bounded reachable set, and it is argued that, when the resolving experience is unrelated in content to where an unresolved state arose and verification is scarce, a reliable discoverer must realize three roles: retaining the unresolved state, ranking candidates by a signal that presupposes neither the resolution condition nor content similarity, and funding verification that goal-conditioned utility does not support. Second, it is hypothesized that concern-relative appraisal with directional complementarity realizes this signal and transfers to new concerns and domains, and functional emotion is defined as the assembly that realizes the three roles through an appraisal representation meeting testable criteria. A thought experiment, a comparison of routes and six falsifiable predictions examine the argument. The analysis yields a functional account of subjectivity, located in the origin of an appraisal rather than of a lack, an answer to Meno's paradox, and a case for self-binding against erosion by self-improvement. Emotion is not claimed to be the only route to discovery; the functions attributed to it are argued to be advantageous where a repertoire expands.</jats:p>\\\", \\\"URL\\\": \\\"https://doi.org/10.2139/ssrn.7535040\\\", \\\"published\\\": {\\\"date-parts\\\": [[2026]]}}, {\\\"DOI\\\": \\\"10.4324/9780203130810-18\\\", \\\"title\\\": [\\\"Open-Ended Problem Solving\\\"], \\\"URL\\\": \\\"https://doi.org/10.4324/9780203130810-18\\\", \\\"published\\\": {\\\"date-parts\\\": [[2013, 6, 26]]}}, {\\\"DOI\\\": \\\"10.1002/9781118946084.part1\\\", \\\"title\\\": [\\\"Introduction to the Open‐Ended Problem Approach\\\"], \\\"URL\\\": \\\"https://doi.org/10.1002/9781118946084.part1\\\", \\\"published\\\": {\\\"date-parts\\\": [[2015, 4, 7]]}}]\", \"excerpt_truncated\": false, \"source_sha256\": \"64a1ad13a29c69539daa9ca15c6d0073a7db0c5e6799795389aace127d567d41\", \"verification_required\": true, \"topic_domain\": \"unassigned_problem\", \"evidence_role\": \"discovery\", \"host_tier\": \"discovery\", \"source_identity\": null, \"persistent_identifiers\": [\"doi:10.1021/acs.chemmater.2c03118.s001\", \"doi:10.2139/ssrn.7535040\", \"doi:10.4324/9780203130810-18\", \"doi:10.1002/9781118946084.part1\"], \"source_candidates\": [\"https://doi.org/10.1021/acs.chemmater.2c03118.s001\", \"https://doi.org/10.2139/ssrn.7535040\", \"https://doi.org/10.4324/9780203130810-18\", \"https://doi.org/10.1002/9781118946084.part1\"], \"source_candidate_identities\": {}}", "id": "source-f4682fe8275a4a9e", "scope": "collected", "source": "https://api.crossref.org/works?query=autonomous+problem+formulation+evaluation+open-ended+discovery+mechanisms&rows=4&select=DOI%2Ctitle%2