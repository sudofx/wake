ash": "cb99aef60d3952743613ac2a93022e21e48e45d3733c5779ecae5a4c0809b217"}, {"seq": 1073, "time": "2026-11-04T18:17:29.504167+00:00", "kind": "observation", "payload": {"actor": "collector", "content": "{\"url\": \"https://doi.org/10.1109/icdl53763.2022.9962187\", \"error\": \"ValueError\", \"scope\": \"fetch failed; no evidence obtained\"}", "id": "source-da3fa34fe2e0467a", "scope": "failed", "source": "https://doi.org/10.1109/icdl53763.2022.9962187"}, "prev_hash": "7b703b1f066e0908ef3bf1895cdd37e2ac0ab7fd3d5d42e27a21bb3d6585cc1c", "hash": "d9e5a23011071fb821b395fa6cfff5ddde5b68d71eb4aa5de3e2cc015f47012e"}, {"seq": 1072, "time": "2026-11-04T18:17:10.012078+00:00", "kind": "acquisition_assessed", "payload": {"domain": "unassigned_objectives", "evidence": "source-d35298c0f1ed4635", "outcome": "routing_progress", "persistent_identifiers": ["doi:10.1109/icdl53763.2022.9962187", "doi:10.70675/6f863351zdd37z4da4z9fa2z5ceed27ddd07", "doi:10.1109/tamd.2012.2208457", "doi:10.1017/9781316823279.017"], "project": "unassigned-objectives-study-001", "research_id": "immediate-7dce264953cf55ab", "route": "api.crossref.org:discovery", "source_candidate_identities": {}, "source_candidates": ["https://doi.org/10.1109/icdl53763.2022.9962187", "https://doi.org/10.70675/6f863351zdd37z4da4z9fa2z5ceed27ddd07", "https://doi.org/10.1109/tamd.2012.2208457", "https://doi.org/10.1017/9781316823279.017"], "stage": "discovery"}, "prev_hash": "397b877f583a7df7551f58bff26ccb69a196351d99838b67ee90b3aae5e06bbc", "hash": "7b703b1f066e0908ef3bf1895cdd37e2ac0ab7fd3d5d42e27a21bb3d6585cc1c"}, {"seq": 1071, "time": "2026-11-04T18:16:55.307628+00:00", "kind": "observation", "payload": {"actor": "collector", "content": "{\"url\": \"https://api.crossref.org/works?query=autonomous+goal+formation+intrinsic+motivation+objective+discovery+reinforcement+learning&rows=4&select=DOI%2Ctitle%2Cabstract%2CURL%2Cpublished\", \"scope\": \"Crossref bibliographic metadata and abstracts where supplied; not full papers\", \"excerpt\": \"[{\\\"DOI\\\": \\\"10.1109/icdl53763.2022.9962187\\\", \\\"title\\\": [\\\"Getting Priorities Right: Intrinsic Motivation with Multi-Objective Reinforcement Learning\\\"], \\\"URL\\\": \\\"https://doi.org/10.1109/icdl53763.2022.9962187\\\", \\\"published\\\": {\\\"date-parts\\\": [[2022, 9, 12]]}}, {\\\"DOI\\\": \\\"10.70675/6f863351zdd37z4da4z9fa2z5ceed27ddd07\\\", \\\"title\\\": [\\\"Learning increasingly complex skills through deep reinforcement learning using intrinsic motivation\\\"], \\\"abstract\\\": \\\"<jats:title>Apprentissage de compétences de plus en plus complexes via l'apprentissage profond par renforcement en utilisant la motivation intrinsèque</jats:title>\\\\n                <jats:p xml:lang=\\\\\\\"fr\\\\\\\">En apprentissage par renforcement (RL), un agent apprend à résoudre une tâche en interagissant avec son environnement. Aﬁn de faire passer à l’échelle ces agents sur des tâches complexes, les méthodes récentes ont proposé avec succès d’intégrer les méthodes d’apprentissage profond au RL, créant le domaine d’apprentissage profond par renforcement (DRL). Cependant, la signiﬁcation sémantique d’une tâche est toujours pourvue par une fonction de récompense experte qui guide l’agent dans son processus d’apprentissage. Ce paradigme contraste avec la manière dont les animaux et humains apprennent: les travaux de psychologie suggèrent que les humains sont intrinsèquement motivés à acquérir de nouvelles connaissances à propos de leur environnement. Dans cette thèse, notre objectif est d’étudier comment la motivation intrinsèque permet de résoudre les problèmes expérimentés par le DRL. Tout d’abord, nous mettons en évidence comment les motivations intrinsèques actuelles attaquent certains problèmes du DRL. Nous classiﬁons et formalisons les méthodes, puis analysons leurs limites. Aﬁn d’exhiber leur importance, nous mettons en avant que ces verrous peuvent empêcher un agent d’apprendre des compétences et représentations de l’environnement de plus en plus complexes. Ce sont des éléments-clés pour faire apprendre des agents autonomes comme des humains. Á partir de cette analyse, nous introduisons deux nouveaux modèles qui peuvent apprendre des compétences diverses et spéciﬁques à une tâche de bout en bout. Le premier, ELSIM, construit un arbre discret de compétences dans la direction des récompenses de l’environnement. Nos résultats montrent que ce paradigme d’apprentissage améliore l’exploration dans des environnements avec des récompenses éparses et permet d’utiliser des compétences sur différentes tâches corrélées. Nous mettons en avant les inconvénients d’ELSIM et proposons un autre modèle, DisTop, pour les corriger. DisTop construit progressivement une topologie de l’environnement en utilisant une fonction de coût contrastive, un réseau auto-organisé et une politique dépendante d’objectifs. L’agent peut alors intelligemment contrôler quelles compétences apprendre ou oublier. De cette manière, DisTop est compétitif avec des algorithmes de l’état de l’art sur trois types de tâches différentes, incluant une tâche hiérarchique avec des récompenses éparses. Pour conclure la thèse, nous discutons des perspectives du domaines et des directions futures de notre recherche.</jats:p>\\\", \\\"URL\\\": \\\"https://doi.org/10.70675/6f863351zdd37z4da4z9fa2z5ceed27ddd07\\\"}, {\\\"DOI\\\": \\\"10.1109/tamd.2012.2208457\\\", \\\"title\\\": [\\\"Intrinsic Motivation and Introspection in Reinforcement Learning\\\"], \\\"URL\\\": \\\"https://doi.org/10.1109/tamd.2012.2208457\\\", \\\"published\\\": {\\\"date-parts\\\": [[2012, 12]]}}, {\\\"DOI\\\": \\\"10.1017/9781316823279.017\\\", \\\"title\\\": [\\\"Reconceptualizing Intrinsic Motivation\\\"], \\\"URL\\\": \\\"https://doi.org/10.1017/9781316823279.017\\\", \\\"published\\\": {\\\"date-parts\\\": [[2019, 2, 14]]}}]\", \"excerpt_truncated\": false, \"source_sha256\": \"26dd4f827c71508cc9744805aadc420760fcbf1615c5dbd48c17883dac95f3f5\", \"verification_required\": tru