candidates": [], "stage": "substantive_source"}, "prev_hash": "f7fbb874a7dcfef92ae35a2a1089ef0901459a3b342db2dca70b1db70df0c39d", "hash": "c7d2a28de5ecf1f19d8bc5eb1875240f077d45ccee6b95be22208005f8df5225"}, {"seq": 737, "time": "2026-10-27T14:34:04.291174+00:00", "kind": "observation", "payload": {"actor": "collector", "content": "{\"url\": \"https://doi.org/10.2139/ssrn.7540068\", \"error\": \"HTTPError\", \"scope\": \"fetch failed; no evidence obtained\"}", "id": "source-2d0c755ea48847ab", "scope": "failed", "source": "https://doi.org/10.2139/ssrn.7540068"}, "prev_hash": "89a0f3d4082aa5bdd60d9b4dbce35519ebd6e392952db491aed823e2eff02788", "hash": "f7fbb874a7dcfef92ae35a2a1089ef0901459a3b342db2dca70b1db70df0c39d"}, {"seq": 736, "time": "2026-10-27T14:33:53.597202+00:00", "kind": "acquisition_assessed", "payload": {"domain": "emergent_preferences", "evidence": "source-d42ba0f9d94443a1", "outcome": "routing_progress", "persistent_identifiers": ["doi:10.2139/ssrn.7540068", "doi:10.14711/thesis-b1114789", "doi:10.14711/thesis-b1252000", "doi:10.2202/1558-3708.1104"], "project": "proj-emergent-prefs-01", "research_id": "immediate-2a10142d334993a8", "route": "api.crossref.org:discovery", "source_candidate_identities": {}, "source_candidates": ["https://doi.org/10.2139/ssrn.7540068", "https://doi.org/10.14711/thesis-b1114789", "https://doi.org/10.14711/thesis-b1252000", "https://doi.org/10.2202/1558-3708.1104"], "stage": "discovery"}, "prev_hash": "eccec700a16b4d4d8d3256bd150ff227372ec8c0377bbec6d0d6cf58920e183b", "hash": "89a0f3d4082aa5bdd60d9b4dbce35519ebd6e392952db491aed823e2eff02788"}, {"seq": 735, "time": "2026-10-27T14:33:42.755391+00:00", "kind": "observation", "payload": {"actor": "collector", "content": "{\"url\": \"https://api.crossref.org/works?query=continuous+attractor+dynamics+preference+stability+path+dependence&rows=4&select=DOI%2Ctitle%2Cabstract%2CURL%2Cpublished\", \"scope\": \"Crossref bibliographic metadata and abstracts where supplied; not full papers\", \"excerpt\": \"[{\\\"DOI\\\": \\\"10.2139/ssrn.7540068\\\", \\\"title\\\": [\\\"Attractor-Weighted Neuromodulation of Reward Path Dependence and Habit Formation\\\"], \\\"abstract\\\": \\\"<jats:p>This paper proposes a formal dynamical-systems theory of reward-seeking path dependence in the brain. The central claim is that repeated reward-seeking does not merely increase or decrease dopamine in a colloquial sense; rather, it reshapes a multiscale state space in which action sequences become attractors, habit chunks, and context-sensitive policy priors. The model is built on three established empirical commitments: first, midbrain dopamine neurons encode reward prediction error rather than pleasure itself; second, dopamine contributes more to wanting than liking ; and third, cortico-striatal circuits progressively chunk repeated actions into stable habit-like sequences. We extend these findings into a multineuromodulator model in which dopamine, opioids, serotonin, noradrenaline, and acetylcholine jointly regulate incentive salience, hedonic impact, temporal discounting, and uncertainty. The resulting theory explains why some reward paths intensify into compulsive attractors, why devaluation does not automatically terminate them, and why transitions to alternative behavioral regimes depend on a stability shift in the underlying attractor landscape rather than on a simple drop in reward.</jats:p>\\\", \\\"URL\\\": \\\"https://doi.org/10.2139/ssrn.7540068\\\", \\\"published\\\": {\\\"date-parts\\\": [[2026]]}}, {\\\"DOI\\\": \\\"10.14711/thesis-b1114789\\\", \\\"title\\\": [\\\"Dynamics of continuous attractor neural networks\\\"], \\\"URL\\\": \\\"https://doi.org/10.14711/thesis-b1114789\\\"}, {\\\"DOI\\\": \\\"10.14711/thesis-b1252000\\\", \\\"title\\\": [\\\"Dynamics of continuous attractor neural networks with dynamical synapses\\\"], \\\"URL\\\": \\\"https://doi.org/10.14711/thesis-b1252000\\\"}, {\\\"DOI\\\": \\\"10.2202/1558-3708.1104\\\", \\\"title\\\": [\\\"Stochastic Growth with Increasing Returns: Stability and Path Dependence\\\"], \\\"URL\\\": \\\"https://doi.org/10.2202/1558-3708.1104\\\", \\\"published\\\": {\\\"date-parts\\\": [[2003, 1, 1]]}}]\", \"excerpt_truncated\": false, \"source_sha256\": \"d562f2a49aef78999405fc0689b8b6b147aeabcb0165b8c190b86f70b15ec929\", \"verification_required\": true, \"topic_domain\": \"emergent_preferences\", \"evidence_role\": \"discovery\", \"host_tier\": \"discovery\", \"source_identity\": null, \"persistent_identifiers\": [\"doi:10.2139/ssrn.7540068\", \"doi:10.14711/thesis-b1114789\", \"doi:10.14711/thesis-b1252000\", \"doi:10.2202/1558-3708.1104\"], \"source_candidates\": [\"https://doi.org/10.2139/ssrn.7540068\", \"https://doi.org/10.14711/thesis-b1114789\", \"https://doi.org/10.14711/thesis-b1252000\", \"https://doi.org/10.2202/1558-3708.1104\"], \"source_candidate_identities\": {}}", "id": "source-d42ba0f9d94443a1", "scope": "collected", "source": "https://api.crossref.org/works?query=continuous+attractor+dynamics+preference+stability+path+dependence&rows=4&select=DOI%2Ctitle%2Cabstract%2CURL%2Cpublished"}, "prev_hash": "8c48ab637488bf4613f8670f6f7705cf6b0b249e26b2e7481cc11d496563db53", "hash": "eccec700a16b4d4d8d3256bd150ff227372ec8c0377bbec6d0d6cf58920e183b"}, {"seq": 734, "time": "2026-10-27T14:33:29.683207+00:00", "kind": "research_planned", "payload": {"id": "w-a57b7660ff9d4e77", "metadata": {"model_version": "gemini-3.5-flash-lite", "provider_attempts": [{"http_status": null, "model": "gemini-3.1-flash-lite", "provider_call_made": false, "provider_input_chars": 26461, "provider_input_hash": "fa590b65634995b5928150f0f7a43700b334ff0f7f7143924041eb98c6426659", "result": "daily_quota", "retry_after_seconds": 58939.82405376434}, {"elapsed_ms": 2253, "finish_reason": "STOP", "http_status": 200, "model": "gemini-3.5-flash-lite", "model_version": "gemini-3.5-flash-lite", "provider": "google-gemini", "provider_input_chars": 26461, "provider_input_hash": "fa590b65634995b5928