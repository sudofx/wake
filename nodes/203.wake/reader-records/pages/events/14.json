{"head": "308367bdb9899aa4f079b9094f255f2b9d1d10fdb23ae092f8c18eec49b39610", "collection": "events", "rows": [{"seq": 214, "time": "2026-10-22T21:25:18.319370+00:00", "kind": "observation", "payload": {"actor": "collector", "content": "{\"url\": \"https://api.crossref.org/works?query=path+dependence+and+preference+stability+in+autonomous+decision-making+systems&rows=4&select=DOI%2Ctitle%2Cabstract%2CURL%2Cpublished\", \"scope\": \"Crossref bibliographic metadata and abstracts where supplied; not full papers\", \"excerpt\": \"[{\\\"DOI\\\": \\\"10.1109/isads.1999.838451\\\", \\\"title\\\": [\\\"On the concept of \\\\\\\"stability\\\\\\\" in asynchronous distributed decision-making systems\\\"], \\\"URL\\\": \\\"https://doi.org/10.1109/isads.1999.838451\\\"}, {\\\"DOI\\\": \\\"10.65109/ygug5829\\\", \\\"title\\\": [\\\"Preference Inference from Demonstration in Multi-objective Multi-agent Decision Making\\\"], \\\"abstract\\\": \\\"<jats:p>It is challenging to quantify numerical preferences for different objectives in a multi-objective decision-making problem. However, the demonstrations of a user are often accessible. We propose an algorithm to infer linear preference weights from either optimal or near-optimal demonstrations. The algorithm is evaluated in three environments with two baseline methods. Empirical results demonstrate significant improvements compared to the baseline algorithms, in terms of both time requirements and accuracy of the inferred preferences. In future work, we plan to evaluate the algorithm's effectiveness in a multi-agent system, where one of the agents is enabled to infer the preferences of an opponent using our preference inference algorithm.</jats:p>\\\", \\\"URL\\\": \\\"https://doi.org/10.65109/ygug5829\\\", \\\"published\\\": {\\\"date-parts\\\": [[2023, 5, 30]]}}, {\\\"DOI\\\": \\\"10.1007/978-3-642-51711-2_4\\\", \\\"title\\\": [\\\"Fuzzy Preference Relations in Group Decision Making\\\"], \\\"URL\\\": \\\"https://doi.org/10.1007/978-3-642-51711-2_4\\\", \\\"published\\\": {\\\"date-parts\\\": [[1988]]}}, {\\\"DOI\\\": \\\"10.15368/theses.2013.140\\\", \\\"title\\\": [\\\"A GENERIC DECISION MAKING FRAMEWORK FOR AUTONOMOUS SYSTEMS\\\"], \\\"URL\\\": \\\"https://doi.org/10.15368/theses.2013.140\\\"}]\", \"excerpt_truncated\": false, \"source_sha256\": \"5b8675555e1c8ff10e0eaf35ac2a8dad9dfce449d56fe28e356a62e477d2a191\", \"verification_required\": true, \"topic_domain\": \"emergent_preferences\", \"evidence_role\": \"discovery\", \"host_tier\": \"discovery\", \"source_identity\": null, \"persistent_identifiers\": [\"doi:10.1109/isads.1999.838451\", \"doi:10.65109/ygug5829\", \"doi:10.1007/978-3-642-51711-2_4\", \"doi:10.15368/theses.2013.140\"], \"source_candidates\": [\"https://doi.org/10.1109/isads.1999.838451\", \"https://doi.org/10.65109/ygug5829\", \"https://doi.org/10.1007/978-3-642-51711-2_4\", \"https://doi.org/10.15368/theses.2013.140\"], \"source_candidate_identities\": {}}", "id": "source-1441737cfc894d4b", "scope": "collected", "source": "https://api.crossref.org/works?query=path+dependence+and+preference+stability+in+autonomous+decision-making+systems&rows=4&select=DOI%2Ctitle%2Cabstract%2CURL%2Cpublished"}, "prev_hash": "e5d2ac83a7f1c10bb2521a71c7447b4cc133a068fff34536215740e50cd78e08", "hash": "b533f692a4152bd6633abb0af380fd53d6f119e774153883e621eba2716489d6"}, {"seq": 213, "time": "2026-10-22T21:25:17.592891+00:00", "kind": "acquisition_assessed", "payload": {"domain": "emergent_preferences", "evidence": "source-cc6662ab710244ba", "outcome": "route_failure", "persistent_identifiers": [], "project": "proj-emergent-prefs-001", "research_id": "immediate-9e5f93aea5032ba9", "route": "www.bing.com:discovery", "source_candidate_identities": {}, "source_candidates": [], "stage": "discovery"}, "prev_hash": "296d8fa52d3d7c1d9eb114bb644fa93e87f24d3cfb48650fff12e72d057e067c", "hash": "e5d2ac83a7f1c10bb2521a71c7447b4cc133a068fff34536215740e50cd78e08"}, {"seq": 212, "time": "2026-10-22T21:25:17