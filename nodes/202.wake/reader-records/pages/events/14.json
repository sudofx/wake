on", "payload": {"actor": "collector", "content": "{\"url\": \"https://doi.org/10.20944/preprints202607.1126.v1\", \"error\": \"ValueError\", \"scope\": \"fetch failed; no evidence obtained\"}", "id": "source-f1fc268e708d480d", "scope": "failed", "source": "https://doi.org/10.20944/preprints202607.1126.v1"}, "prev_hash": "45be7a30fb4cf33d75785bc429d548b17a71cf378306b7162193ad593d522ec5", "hash": "04c2f574b49f04727e6b3777c94c3a53f033c6151bd888068c307823dcd7d43d"}, {"seq": 93, "time": "2026-10-22T20:52:08.271077+00:00", "kind": "acquisition_assessed", "payload": {"domain": "assumption_challenge", "evidence": "source-77a730f54c4e4cb3", "outcome": "routing_progress", "persistent_identifiers": ["doi:10.20944/preprints202607.1126.v1", "doi:10.5220/0010803700003116", "doi:10.1007/s10817-008-9111-8", "doi:10.4324/9780429030239-7"], "project": "proj-meta-reasoning-01", "research_id": "immediate-1ad56faabf874dbb", "route": "api.crossref.org:discovery", "source_candidate_identities": {}, "source_candidates": ["https://doi.org/10.20944/preprints202607.1126.v1", "https://doi.org/10.5220/0010803700003116", "https://doi.org/10.1007/s10817-008-9111-8", "https://doi.org/10.4324/9780429030239-7"], "stage": "discovery"}, "prev_hash": "f30ca4ba7a8fa2464aaf67cae5890b9f35e2232c75019dcf8b8caf1bf7d0fb0b", "hash": "45be7a30fb4cf33d75785bc429d548b17a71cf378306b7162193ad593d522ec5"}, {"seq": 92, "time": "2026-10-22T20:52:08.130470+00:00", "kind": "observation", "payload": {"actor": "collector", "content": "{\"url\": \"https://api.crossref.org/works?query=formal+epistemological+frameworks+for+automated+assumption+checking+and+falsification+strategies&rows=4&select=DOI%2Ctitle%2Cabstract%2CURL%2Cpublished\", \"scope\": \"Crossref bibliographic metadata and abstracts where supplied; not full papers\", \"excerpt\": \"[{\\\"DOI\\\": \\\"10.20944/preprints202607.1126.v1\\\", \\\"title\\\": [\\\"Automated Scientific Discovery via Causal Falsification and Formal Multi-Agent Verification\\\"], \\\"abstract\\\": \\\"<jats:p>Scientific AI systems can generate hypotheses and explanations, but many opti-mize plausibility more than refutability. This paper presents a falsification-drivenmulti-agent framework in which specialized agents propose hypotheses, build causalmodels, design adversarial tests, and verify formal claims. The architecture com-bines hypothesis generation, causal reasoning, falsification, formal verification, andpersistent orchestration through a shared memory state that records assumptions,counterexamples, interventions, and proof obligations. By treating failed predictionsand invalid proof attempts as useful learning signals, the framework shifts discoveryfrom fluent claim production toward disciplined claim survival. On simulated dis-covery tasks, the full system improves verified discovery rate from 0.42 to 0.76 andreduces false-positive hypothesis retention from 0.31 to 0.08. Scaling experimentsshow a peak discovery quality factor of 0.83 with eight agents, supporting the prin-ciple that scientific AI should prioritize systematic refutation, causal identifiability,and machine-checkable proof.</jats:p>\\\", \\\"URL\\\": \\\"https://doi.org/10.20944/preprints202607.1126.v1\\\", \\\"published\\\": {\\\"date-parts\\\": [[2026, 7, 15]]}}, {\\\"DOI\\\": \\\"10.5220/0010803700003116\\\", \\\"title\\\": [\\\"Falsification-aware Semantics for CTL and Its Inconsistency-tolerant Subsystem: Towards Falsification-aware Model Checking\\\"], \\\"URL\\\": \\\"https://doi.org/10.5220/0010803700003116\\\", \\\"published\\\": {\\\"date-parts\\\": [[2022]]}}, {\\\"DOI\\\": \\\"10.1007/s10817-008-9111-8\\\", \\\"title\\\": [\\\"Assumption–Commitment Support for CSP Model Checking\\\"], \\\"URL\\\": \\\"https://doi.org/10.1007/s10817-008-9111-8\\\", \\\"published\\\": {\\\"date-parts\\\": [[2008, 11]]}}, {\\\"DOI\\\": \\\"10.4324/9780429030239-7\\\", \\\"title\\\": [\\\"Checking and Bootstrapping\\\"], \\\"URL\\\": \\\"https://doi.org/10.4324/9780429030239-7\\\", \