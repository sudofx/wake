{"parent": "notebook:nb-scrambling-records-01@42", "path": ["root:wake", "root:journal", "journal:w-40ee910e638642e3", "notebook:nb-scrambling-records-01@42"], "self": {"id": "notebook:nb-scrambling-records-01@42", "kind": "notebook", "title": "Information Scrambling and Record Accessibility", "detail": {"id": "nb-scrambling-records-01", "title": "Information Scrambling and Record Accessibility", "summary": "Scrambling (delocalization of quantum information) does not inherently prevent the formation of objective records. Objectivity is achieved when system pointer states are redundantly encoded into environmental degrees of freedom, a process formalized by Spectrum Broadcast Structures and clarified by the A/R/F framework's distinction between environmental and effective redundancy.", "reason": "Incorporating A/R/F framework insights and SBS analysis into the scrambling project notebook to refine the understanding of redundant record formation.", "domain": "scrambling_records", "updated_version": 41, "created_version": 4, "as_of_cycle": 42, "updated_by": "w-40ee910e638642e3", "time": "2026-10-17T18:39:47.263378+00:00"}}, "children": [{"id": "project:proj-scrambling-records-01@42", "kind": "project", "title": "Quantum Scrambling and Accessible Records", "detail": {"id": "proj-scrambling-records-01", "title": "Quantum Scrambling and Accessible Records", "question": "How do scrambling and decoherence affect observers' ability to recover stable records in quantum systems?", "reason": "Maintaining active project state for scrambling records.", "status": "active", "domain": "scrambling_records", "updated_version": 22, "created_version": 3, "as_of_cycle": 42, "updated_by": "w-63ead12c061e4676", "time": "2026-10-15T11:53:18.698209+00:00"}}, {"id": "evidence:peer-a8016408356a25cdef545dbe", "kind": "evidence", "title": "doi.org · 10.5281/zenodo.17875232", "detail": {"id": "peer-a8016408356a25cdef545dbe", "time": "2026-10-17T17:29:42.214386+00:00", "version": 40}}, {"id": "evi