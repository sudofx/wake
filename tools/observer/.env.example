# Optional: enables the "Ask Gemini" button. Never commit your real .env file.
GEMINI_API_KEY=replace-with-your-key
WAKE_OBSERVER_GEMINI_MODEL=gemini-3.1-flash-lite

# Optional: start already pointed at a public WAKE state branch.
WAKE_OBSERVER_REPOSITORY=sudofx/wake
WAKE_OBSERVER_BRANCH=wake-state

# Optional: choose another local port.
# WAKE_OBSERVER_PORT=8765
