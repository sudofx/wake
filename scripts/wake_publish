#!/usr/bin/env bash
# Upload an installation snapshot with the host's existing Git credentials.
set -Eeuo pipefail
repo_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_dir"
if [[ -f .env ]]; then set -a; source .env; set +a; fi
if [[ "${WAKE_MIRROR_LEASED:-}" != 1 ]]; then
  exec python3 scripts/wake_mirror.py --publish "$@"
fi
: "${WAKE_PUBLISH_REPOSITORY:?Configure WAKE_PUBLISH_REPOSITORY in .env}"
: "${WAKE_PUBLISH_BRANCH:?Configure WAKE_PUBLISH_BRANCH in .env}"
progress(){ printf 'WAKE publish: %s\n' "$*"; }
check_actions(){
  local publish_repo="${WAKE_PUBLISH_REPOSITORY#https://github.com/}"
  publish_repo="${publish_repo#git@github.com:}"
  publish_repo="${publish_repo%.git}"
  command -v gh >/dev/null || { progress 'GitHub CLI is required to check running Actions.'; return 1; }
  local running_actions
  running_actions="$(gh run list --repo "$publish_repo" --status in_progress --json databaseId --jq length)"
  if [[ "$running_actions" != 0 ]]; then
    progress 'GitHub Actions is running. Try publishing again when it is idle.'
    return 1
  fi
}
stage='checking running GitHub Actions'
trap 'printf "WAKE publish: failed while %s; upload not confirmed.\n" "$stage" >&2' ERR
progress 'Checking running GitHub Actions; research keeps its current setting.'
check_actions
public_dir="$(mktemp -d "${TMPDIR:-/tmp}/wake-public.XXXXXX")"
container_dir="/tmp/wake-public-$(date +%s)-$$"
cleanup(){
  rm -rf "$public_dir"
  docker exec wake rm -rf "$container_dir" >/dev/null 2>&1 || true
}
trap cleanup EXIT
# Pin immutable exports; neither capture nor delivery changes research controls.
stage='enabling mirror delivery'
progress 'Connecting to the installation.'
docker exec wake wake-research mirror-enable >/dev/null
stage='capturing and building website pages'
progress 'Capturing completed node exports; unavailable workers do not delay capture.'
docker exec wake python -c 'from pathlib import Path; import sys; from wake.installation_cli import build_public_artifact; build_public_artifact(Path("/data"), Path(sys.argv[1]), progress=lambda message: print(message, flush=True))' "$container_dir"
stage='copying the website to the Mac'
progress 'Copying the prepared website to your Mac.'
docker cp "wake:$container_dir/." "$public_dir/site"
# Reuse GitHub CLI authentication for HTTPS without storing a token or changing
# the user's global Git configuration. Other credentials remain native Git's job.
if [[ "$WAKE_PUBLISH_REPOSITORY" == https://github.com/* ]] && command -v gh >/dev/null 2>&1; then
  export GIT_CONFIG_COUNT=1
  export GIT_CONFIG_KEY_0=credential.helper
  export GIT_CONFIG_VALUE_0='!gh auth git-credential'
fi
stage='checking Actions before upload'
check_actions
stage='uploading the website snapshot to GitHub'
progress 'Uploading the website snapshot to GitHub.'
python3 scripts/publish_pages.py --artifact "$public_dir/site"
stage='recording delivery'
progress 'Recording successful delivery of the captured heads.'
python3 scripts/wake_mirror.py --record-delivery "$public_dir/site/installation.json"
# Legacy controllers understand only Bob digests. The host delivery receipt
# above retains the exact captured head digest regardless of controller age.
publication_digest="$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1])).get("publication_digest") or "")' "$public_dir/site/installation.json")"
if [[ -n "$publication_digest" ]]; then
  docker exec wake wake-research mirror-ack "$publication_digest" >/dev/null
fi
progress 'Done. GitHub has the snapshot; Pages rebuilds separately. Research was not stopped.'
