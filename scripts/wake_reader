#!/usr/bin/env bash
# Explicit, host-loopback-only experiment; never starts or resets research.
set -euo pipefail
repo_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_dir"
if [[ -x .venv/bin/python ]]; then
  exec .venv/bin/python -m wake.reader_preview "$@"
fi
exec python3 -m wake.reader_preview "$@"
