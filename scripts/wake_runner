#!/usr/bin/env bash
# Local standalone WAKE container creator, status reporter, and research control.
# Existing containers are only inspected unless an explicit --research action
# is supplied. No operation deletes or replaces a data volume.

set -euo pipefail

IMAGE="wake-standalone:vscode"
LABEL="com.sudofx.wake.runner"
GROUP_ROUTER="wake.local"
LEGACY_GROUP_ROUTER="wake-group-router"
repo_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P)"
CAMPAIGN_PROGRESS_CODE='from wake.kernel.record import Record; from wake.matrix import continuity_matrix_progress; r=Record.open_read_only("/data/wake.sqlite"); _,root=r.replay(); app=root.get("app:wake"); state=app.get("projection_state") if isinstance(app,dict) else None; p=continuity_matrix_progress(state); print("none" if p is None else str(p["completed_count"])+"/"+str(p["cell_count"]))'

usage() {
    cat <<'EOF'
Usage:
  scripts/wake_runner [container-or-group-name] [--count N] [--campaign none] [--dotfiles=false]
  scripts/wake_runner --research stop|start|pause|reset|status [container-name]
  scripts/wake_runner --container stop|start|pause|remove [container-name-or-group]

Without a research action, an absent container is created and started; an
existing container is left unchanged and its status is reported. New containers
join continuity@1 by default. `--campaign none` opts a newly created container
out. Campaign enrollment is immutable after creation.

`--count N` creates a local group named by the positional argument, for example
`wake_runner wake.local --count 3`. The group prefix is required with `--count`.
Without `--count`, `wake` is a single standalone container published on a random
host port on all host network interfaces.

New containers copy any available ~/.bashrc, ~/.gitignore, ~/.bash_profile,
~/.profile, ~/.bash_aliases and ~/.inputrc files into their home volume by
default. Use `--dotfiles=false` or `--no-dotfiles` to skip importing them.

Groups use Docker container names 001.PREFIX through NNN.PREFIX and receive
separate data volumes and Docker-assigned host ports published on the host's
network interfaces. The bare PREFIX hostname serves the group proxy directory.
Group members share a private Docker bridge
and read-only research summaries. Optional per-member topic files live at
.wake-runner-topics/NNN.PREFIX.toml. Research controls leave Docker running.
Container remove also removes the selected container's data volumes.
EOF
}

fail() { printf 'wake_runner: %s\n' "$*" >&2; return 1; }

data_volume_for() {
    if [[ "$1" == wake ]]; then
        printf '%s' 'wake-standalone-preview_wake-data'
    else
        printf '%s-data' "$1"
    fi
}

group_network_for() { printf 'wake-group-%s' "$1"; }

ensure_group_network() {
    local group_id="$1" network label
    network="$(group_network_for "$group_id")"
    if docker network inspect "$network" >/dev/null 2>&1; then
        label="$(docker network inspect --format "{{ index .Labels \"$LABEL.group\" }}" "$network")"
        [[ "$label" == "$group_id" ]] ||
            fail "Network '$network' exists but is not owned by wake_runner group '$group_id'."
        return 0
    fi
    docker network create --driver bridge \
        --label "$LABEL=true" --label "$LABEL.group=$group_id" "$network" >/dev/null
}

cleanup_group_network() {
    local group_id="$1" network label attached
    [[ -n "$group_id" ]] || return 0
    network="$(group_network_for "$group_id")"
    docker network inspect "$network" >/dev/null 2>&1 || return 0
    label="$(docker network inspect --format "{{ index .Labels \"$LABEL.group\" }}" "$network")"
    [[ "$label" == "$group_id" ]] || return 0
    if container_exists "$GROUP_ROUTER"; then
        ensure_group_router_identity "$GROUP_ROUTER"
        docker network disconnect "$network" "$GROUP_ROUTER" >/dev/null 2>&1 || true
    elif container_exists "$LEGACY_GROUP_ROUTER"; then
        ensure_group_router_identity "$LEGACY_GROUP_ROUTER"
        docker network disconnect "$network" "$LEGACY_GROUP_ROUTER" >/dev/null 2>&1 || true
    fi
    attached="$(docker network inspect --format '{{range .Containers}}{{.Name}} {{end}}' "$network")"
    [[ -n "$attached" ]] || docker network rm "$network" >/dev/null
}

host_lan_ipv4() {
    local iface address
    if command -v networksetup >/dev/null 2>&1 && command -v ipconfig >/dev/null 2>&1; then
        iface="$(networksetup -listallhardwareports 2>/dev/null | awk '/Hardware Port: Wi-Fi/{getline; sub(/^Device: /, ""); print; exit}')"
        if [[ -n "$iface" ]]; then
            address="$(ipconfig getifaddr "$iface" 2>/dev/null || true)"
            [[ -n "$address" ]] && { printf '%s\n' "$address"; return 0; }
        fi
        iface="$(route -n get default 2>/dev/null | awk '$1 == "interface:" {print $2; exit}')"
        if [[ -n "$iface" ]]; then
            address="$(ipconfig getifaddr "$iface" 2>/dev/null || true)"
            [[ -n "$address" ]] && { printf '%s\n' "$address"; return 0; }
        fi
    elif command -v ip >/dev/null 2>&1; then
        address="$(ip -4 route get 1.1.1.1 2>/dev/null | awk '{for (i=1; i<=NF; i++) if ($i == "src") {print $(i+1); exit}}')"
        if [[ -n "$address" && "$address" != 127.* ]]; then
            printf '%s\n' "$address"
            return 0
        fi
    fi
    return 1
}

ensure_group_router_identity() {
    local name="${1:-$GROUP_ROUTER}" runner_label router_label
    container_exists "$name" || return 0
    runner_label="$(docker inspect --format "{{ index .Config.Labels \"$LABEL\" }}" "$name")"
    router_label="$(docker inspect --format "{{ index .Config.Labels \"$LABEL.router\" }}" "$name")"
    [[ "$runner_label" == true && "$router_label" == true ]] ||
        fail "Container '$name' is not owned by wake_runner's local group router; leaving it untouched."
    ensure_wake_identity "$name"
}

refresh_group_router() {
    local config_file="$repo_dir/.wake-runner-router.json" routes_file container group_id ordinal network subnet gateway host_port host_ip
    local first_network="" name host label router_network
    local groups=() networks=()
    routes_file="$(mktemp)"
    if container_exists "$LEGACY_GROUP_ROUTER"; then
        ensure_group_router_identity "$LEGACY_GROUP_ROUTER"
        if container_exists "$GROUP_ROUTER"; then
            ensure_group_router_identity "$GROUP_ROUTER"
            docker rm -f "$LEGACY_GROUP_ROUTER" >/dev/null
        else
            docker rename "$LEGACY_GROUP_ROUTER" "$GROUP_ROUTER"
        fi
    fi
    while IFS= read -r container; do
        group_id="$(docker inspect --format "{{ index .Config.Labels \"$LABEL.group\" }}" "$container")"
        [[ -n "$group_id" && "$group_id" != '<no value>' ]] || continue
        if [[ "$container" == "$group_id"-[0-9][0-9][0-9] ]]; then
            ordinal="${container##*-}"
            host="$ordinal.$group_id"
        else
            ordinal="${container%%.*}"
            host="$container"
            [[ "$host" == "$ordinal.$group_id" ]] || continue
        fi
        [[ "$ordinal" =~ ^[0-9]{3}$ ]] || continue
        network="$(group_network_for "$group_id")"
        read -r subnet gateway < <(docker network inspect --format '{{range .IPAM.Config}}{{.Subnet}} {{.Gateway}}{{end}}' "$network")
        [[ -n "$subnet" && -n "$gateway" ]] || { rm -f "$routes_file"; fail "Could not read subnet and gateway for $network."; }
        read -r host_ip host_port < <(docker inspect --format '{{range $i, $binding := (index .NetworkSettings.Ports "8080/tcp")}}{{if eq $i 0}}{{$binding.HostIp}} {{$binding.HostPort}}{{end}}{{end}}' "$container" 2>/dev/null || true) || true
        [[ -n "$host_port" ]] || { rm -f "$routes_file"; fail "Could not read published host port for $container."; }
        printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$host" "$container" "$subnet" "$gateway" "$group_id" "$host_ip" "$host_port" >> "$routes_file"
        groups+=("$group_id")
    done < <(docker ps -a --filter "label=$LABEL.group" --format '{{.Names}}')

    if [[ ! -s "$routes_file" ]]; then
        if container_exists "$GROUP_ROUTER"; then
            ensure_group_router_identity "$GROUP_ROUTER"
            docker rm -f "$GROUP_ROUTER" >/dev/null
        fi
        rm -f "$config_file" "$routes_file"
        return 0
    fi
    python3 - "$routes_file" "$config_file" <<'PY'
import json
import sys

routes = {}
groups = {}
with open(sys.argv[1]) as source:
    for line in source:
        host, target, subnet, gateway, group_id, host_ip, host_port = line.rstrip("\n").split("\t")
        key = host.lower()
        if key in routes and routes[key]["target"] != target:
            raise SystemExit(f"Duplicate local WAKE hostname: {key}")
        routes[key] = {"target": target, "subnet": subnet, "gateway": gateway,
                       "host_ip": host_ip, "host_port": host_port}
        group = groups.setdefault(group_id.lower(), {"members": [], "subnet": subnet, "gateway": gateway})
        if group["subnet"] != subnet or group["gateway"] != gateway:
            raise SystemExit(f"Inconsistent local WAKE group network: {group_id}")
        group["members"].append(key)
with open(sys.argv[2], "w") as target:
    json.dump({"routes": routes, "groups": groups}, target, separators=(",", ":"))
PY
    ((${#groups[@]} > 0)) || { rm -f "$routes_file"; fail 'Group router has no group networks.'; }
    for group_id in "${groups[@]}"; do
        local already=false
        for name in "${networks[@]}"; do [[ "$name" == "$(group_network_for "$group_id")" ]] && already=true; done
        [[ "$already" == true ]] || networks+=("$(group_network_for "$group_id")")
    done
    first_network="${networks[0]}"
    docker image inspect "$IMAGE" >/dev/null 2>&1 || { rm -f "$routes_file"; fail "Missing image: $IMAGE."; }
    if container_exists "$GROUP_ROUTER"; then
        ensure_group_router_identity "$GROUP_ROUTER"
        docker rm -f "$GROUP_ROUTER" >/dev/null
    fi
    docker run -d --name "$GROUP_ROUTER" \
        --label "$LABEL=true" --label "$LABEL.router=true" \
        --network "$first_network" -p 80:8080 \
        -v "$repo_dir/scripts/wake_group_proxy.py:/workspace/wake_group_proxy.py:ro" \
        -v "$config_file:/run/wake-group-router.json:ro" \
        --read-only --tmpfs /tmp --entrypoint python "$IMAGE" \
        /workspace/wake_group_proxy.py --config /run/wake-group-router.json >/dev/null ||
        { rm -f "$routes_file"; fail 'Could not start the LAN group router on host port 80.'; }
    if ! is_running "$GROUP_ROUTER"; then
        docker logs "$GROUP_ROUTER" >&2 || true
        rm -f "$routes_file"
        fail 'The group router could not bind host port 80 or stopped during startup.'
    fi
    for network in "${networks[@]}"; do
        router_network="$(docker inspect --format "{{if index .NetworkSettings.Networks \"$network\"}}joined{{end}}" "$GROUP_ROUTER")"
        [[ "$router_network" == joined ]] || docker network connect "$network" "$GROUP_ROUTER"
    done
    rm -f "$routes_file"
}

home_volume_for() {
    if [[ "$1" == wake ]]; then
        printf '%s' 'wake-standalone-preview_vscode-home'
    else
        printf '%s-vscode-home' "$1"
    fi
}

copy_host_dotfiles() {
    local home_volume="$1" enabled="${2:-true}" host_home="${HOME:-}"
    local staging_dir dotfile copied=()
    if [[ "$enabled" != true ]]; then
        printf 'DOTFILES: skipped (disabled)\n'
        return 0
    fi
    if [[ -z "$host_home" || ! -d "$host_home" ]]; then
        printf 'DOTFILES: no host home directory found; continuing without dotfiles\n'
        return 0
    fi
    staging_dir="$(mktemp -d "$repo_dir/.wake-runner-dotfiles.XXXXXX")" ||
        fail 'Could not create a temporary dotfiles staging directory.'
    for dotfile in .bashrc .gitignore .bash_profile .profile .bash_aliases .inputrc; do
        if [[ -f "$host_home/$dotfile" ]]; then
            if ! cp "$host_home/$dotfile" "$staging_dir/$dotfile"; then
                rm -rf "$staging_dir"
                fail "Could not stage host dotfile: $host_home/$dotfile"
            fi
            copied+=("$dotfile")
        fi
    done
    if ((${#copied[@]} == 0)); then
        rm -rf "$staging_dir"
        printf 'DOTFILES: no matching host files found; continuing without dotfiles\n'
        return 0
    fi
    if ! docker run --rm --network none --read-only --tmpfs /tmp \
        -v "$home_volume:/home/wake" \
        -v "$staging_dir:/run/wake-dotfiles:ro" \
        -v "$repo_dir/scripts/wake_copy_dotfiles.py:/run/wake-copy-dotfiles.py:ro" \
        --user 0:0 --entrypoint python "$IMAGE" /run/wake-copy-dotfiles.py >/dev/null; then
        rm -rf "$staging_dir"
        fail 'Could not copy host dotfiles into the new container home volume.'
    fi
    rm -rf "$staging_dir"
    printf 'DOTFILES: copied %s into the new container home\n' "${copied[*]}"
}

require_runtime() {
    [[ -f "$repo_dir/.env" && -f "$repo_dir/wake.toml" ]] ||
        fail "Missing .env or wake.toml in $repo_dir"
    [[ -f "$repo_dir/research-topics.toml" ]] ||
        fail "Missing research topics. Run 'cp example.research-topics.toml research-topics.toml', edit the copy, then try again."
    docker info >/dev/null 2>&1 || fail 'Docker is unavailable; start Docker first.'
}

container_exists() { docker container inspect "$1" >/dev/null 2>&1; }

is_running() {
    [[ "$(docker inspect --format '{{.State.Running}}' "$1" 2>/dev/null || true)" == true ]]
}

ensure_wake_identity() {
    local name="$1" image
    container_exists "$name" || return 0
    image="$(docker inspect --format '{{.Config.Image}}' "$name")"
    [[ "$image" == *wake-standalone* ]] ||
        fail "Container '$name' uses image '$image', not a WAKE standalone image; leaving it untouched."
}

data_mount() {
    local name="$1" value
    value="$(docker inspect --format '{{range .Mounts}}{{if eq .Destination "/data"}}{{if .Name}}{{.Name}}{{else}}{{.Source}}{{end}}{{end}}{{end}}' "$name" 2>/dev/null || true)"
    [[ -n "$value" ]] || value="$(data_volume_for "$name")"
    printf '%s' "$value"
}

image_for() {
    docker inspect --format '{{.Config.Image}}' "$1"
}

paused_config() {
    local value
    value="$(docker inspect --format '{{range .Config.Env}}{{println .}}{{end}}' "$1" |
        awk -F= '$1 == "WAKE_PAUSED" {print $2}' | tail -n 1)"
    [[ "${value,,}" == true || "${value,,}" == 1 || "${value,,}" == yes ]]
}

research_mode() {
    local name="$1" value container_paused
    value="$(docker exec "$name" python -c 'import json,pathlib; p=pathlib.Path("/data/.wake-runner-control.json"); print(json.loads(p.read_text()).get("research", "")) if p.exists() else None' 2>/dev/null || true)"
    case "$value" in running|stopped|paused) printf '%s' "$value" ;; *)
        container_paused="$(docker inspect --format '{{.State.Paused}}' "$name" 2>/dev/null || true)"
        if [[ "$container_paused" == true ]] || paused_config "$name"; then printf paused; else printf running; fi ;;
    esac
}

set_research_mode() {
    docker exec "$1" python -c 'import json,os,pathlib,sys; p=pathlib.Path("/data/.wake-runner-control.json"); d=json.loads(p.read_text()) if p.exists() else {}; d["research"]=sys.argv[1]; t=p.with_suffix(".tmp"); t.write_text(json.dumps(d)); os.replace(t,p)' "$2" >/dev/null
}

campaign_progress() {
    local name="$1" volume="$2" image result attempt
    image="$(image_for "$name")"
    if is_running "$name"; then
        # A freshly created standalone process may still be initializing SQLite
        # when the launcher asks for its first status. Retry quietly so a normal
        # startup race does not leak a traceback or hide the useful status line.
        for ((attempt=1; attempt<=15; attempt++)); do
            if result="$(docker exec "$name" python -c "$CAMPAIGN_PROGRESS_CODE" 2>/dev/null)" && [[ -n "$result" ]]; then
                printf '%s' "$result"
                return 0
            fi
            sleep 1
        done
        return 1
    else
        docker run --rm --network none --read-only --tmpfs /tmp \
            -v "$volume:/data:ro" -v "$repo_dir:/workspace:ro" -w /workspace \
            --entrypoint python "$image" -c "$CAMPAIGN_PROGRESS_CODE" 2>/dev/null
    fi
}

report_status() {
    local name="$1" volume research campaign port group_id lan_ip host_ip
    if ! container_exists "$name"; then
        research=stopped
        volume="$(data_volume_for "$name")"
        if docker volume inspect "$volume" >/dev/null 2>&1; then
            campaign="$(docker run --rm --network none --read-only --tmpfs /tmp \
                -v "$volume:/data:ro" -v "$repo_dir:/workspace:ro" -w /workspace \
                --entrypoint python "$IMAGE" -c "$CAMPAIGN_PROGRESS_CODE" 2>/dev/null)" || campaign=unavailable
        else
            campaign=none
        fi
    else
        ensure_wake_identity "$name"
        volume="$(data_mount "$name")"
        if ! is_running "$name"; then
            research=stopped
        else
            research="$(research_mode "$name")"
        fi
        campaign="$(campaign_progress "$name" "$volume")" || campaign=unavailable
    fi
    printf 'CONTAINER: %s | RESEARCH_STATUS: %s | CONTINUITY_CAMPAIGN: %s\n' \
        "$name" "$research" "$campaign"
    if container_exists "$name"; then
        read -r host_ip port < <(docker inspect --format '{{range $i, $binding := (index .NetworkSettings.Ports "8080/tcp")}}{{if eq $i 0}}{{$binding.HostIp}} {{$binding.HostPort}}{{end}}{{end}}' "$name" 2>/dev/null || true) || true
        if [[ -n "$port" ]]; then
            group_id="$(docker inspect --format "{{ index .Config.Labels \"$LABEL.group\" }}" "$name")"
            if [[ -n "$group_id" && "$group_id" != '<no value>' ]]; then
                printf 'URL: http://%s/\n' "$name"
                lan_ip="$(host_lan_ipv4 || true)"
                if [[ "$host_ip" == 127.0.0.1 || "$host_ip" == ::1 ]]; then
                    printf 'LAN URL: unavailable (recreate this loopback-only container for LAN access)\n'
                elif [[ -n "$lan_ip" ]]; then
                    printf 'LAN URL: http://%s:%s/console.html\n' "$lan_ip" "$port"
                else
                    printf 'LAN URL: unavailable (could not detect the host IPv4 address)\n'
                fi
            else
                printf 'Add this to /etc/hosts: 127.0.0.1 %s\n' "$name"
                printf 'URL: http://%s:%s/\n' "$name" "$port"
                printf 'LOCAL URL: http://127.0.0.1:%s/\n' "$port"
                lan_ip="$(host_lan_ipv4 || true)"
                if [[ "$host_ip" == 127.0.0.1 || "$host_ip" == ::1 ]]; then
                    printf 'LAN URL: unavailable (recreate this loopback-only container for LAN access)\n'
                elif [[ -n "$lan_ip" ]]; then
                    printf 'LAN URL: http://%s:%s/console.html\n' "$lan_ip" "$port"
                else
                    printf 'LAN URL: unavailable (could not detect the host IPv4 address)\n'
                fi
            fi
        fi
    fi
}

create_container() {
    local name="$1" campaign="$2" paused="${3:-false}" group_id="${4:-}" peers="${5:-}" dotfiles="${6:-true}"
    local data_volume home_volume topic_file topic_rel network group_instance
    local publish_args=()
    local group_args=(-e WAKE_GROUP_ID= -e WAKE_GROUP_INSTANCE= -e WAKE_GROUP_PEERS= -e WAKE_GROUP_TOPIC_FILE=)
    docker image inspect "$IMAGE" >/dev/null 2>&1 ||
        fail "Missing image: $IMAGE (build the VS Code target first)."
    data_volume="$(data_volume_for "$name")"
    home_volume="$(home_volume_for "$name")"
    copy_host_dotfiles "$home_volume" "$dotfiles"
    publish_args=(-p 8080)
    if [[ -n "$group_id" ]]; then
        network="$(group_network_for "$group_id")"
        group_instance="$group_id-${name%%.*}"
        group_args+=(--network "$network"
            --network-alias "$group_instance"
            --label "$LABEL.group=$group_id"
            -e "WAKE_GROUP_ID=$group_id"
            -e "WAKE_GROUP_INSTANCE=$group_instance"
            -e "WAKE_GROUP_PEERS=$peers")
        topic_file="$repo_dir/.wake-runner-topics/$name.toml"
        if [[ ! -f "$topic_file" ]]; then
            topic_file="$repo_dir/.wake-runner-topics/$group_instance.toml"
        fi
        if [[ -f "$topic_file" ]]; then
            topic_rel=".wake-runner-topics/$(basename -- "$topic_file")"
            group_args+=(-e "WAKE_GROUP_TOPIC_FILE=/workspace/$topic_rel"
                -v "$topic_file:/workspace/$topic_rel:ro")
        fi
    fi
    docker run -d --name "$name" \
        --label "$LABEL=true" \
        "${publish_args[@]}" \
        -v "$data_volume:/data" \
        -v "$home_volume:/home/wake" \
        -v "$repo_dir:/workspace" -w /workspace \
        --env-file "$repo_dir/.env" \
        "${group_args[@]}" \
        -e "WAKE_ENABLE_CONTINUITY_MATRIX=$campaign" \
        -e "WAKE_PAUSED=$paused" \
        -e HTTPS_PROXY=http://http.docker.internal:3128 \
        --read-only --tmpfs /tmp \
        "$IMAGE" --config /workspace/wake.toml >/dev/null
}

ensure_present() {
    local name="$1" campaign="$2" group_id="${3:-}" peers="${4:-}" paused="${5:-false}" dotfiles="${6:-true}"
    local network group_label group_peers
    if container_exists "$name"; then
        ensure_wake_identity "$name"
        if [[ -n "$group_id" ]]; then
            group_label="$(docker inspect --format "{{ index .Config.Labels \"$LABEL.group\" }}" "$name")"
            network="$(group_network_for "$group_id")"
            [[ "$group_label" == "$group_id" ]] ||
                fail "Existing container '$name' is not a member of group '$group_id'; it must be recreated to join this group network. Save its data volume first because container removal deletes unshared volumes."
            docker inspect --format "{{if index .NetworkSettings.Networks \"$network\"}}joined{{end}}" "$name" | grep -q '^joined$' ||
                fail "Existing container '$name' is not connected to '$network'."
            group_peers="$(docker inspect --format '{{range .Config.Env}}{{println .}}{{end}}' "$name" |
                awk -F= '$1 == "WAKE_GROUP_PEERS" {print $2}' | tail -n 1)"
            [[ "$group_peers" == "$peers" ]] ||
                fail "Existing container '$name' has a different peer list; recreate it before changing the group size."
        fi
        return 0
    fi
    create_container "$name" "$campaign" "$paused" "$group_id" "$peers" "$dotfiles"
}

ensure_group_peer_alias() {
    local name="$1" group_id="$2" group_instance="$3" network aliases was_running=false
    network="$(group_network_for "$group_id")"
    aliases="$(docker inspect --format '{{range .NetworkSettings.Networks}}{{range .Aliases}}{{println .}}{{end}}{{end}}' "$name")"
    grep -Fxq "$group_instance" <<< "$aliases" && return 0

    # Keep the stable internal peer ID resolvable while Docker names use the
    # public 001.group.example form. Docker only accepts aliases at connect time.
    if is_running "$name"; then
        docker stop --time 30 "$name" >/dev/null
        was_running=true
    fi
    if ! docker network disconnect "$network" "$name" >/dev/null 2>&1 ||
       ! docker network connect --alias "$group_instance" "$network" "$name"; then
        if ! docker inspect --format "{{if index .NetworkSettings.Networks \"$network\"}}joined{{end}}" "$name" | grep -q '^joined$'; then
            docker network connect "$network" "$name" >/dev/null 2>&1 || true
        fi
        if [[ "$was_running" == true ]]; then docker start "$name" >/dev/null || true; fi
        fail "Could not install peer-discovery alias '$group_instance' for '$name'."
    fi
    if [[ "$was_running" == true ]]; then docker start "$name" >/dev/null; fi
}

reset_research() {
    local name="$1" answer reset_id ack attempt
    [[ -t 0 ]] || fail 'Research reset requires an interactive terminal.'
    container_exists "$name" || fail "Research reset requires an existing container: $name"
    ensure_wake_identity "$name"
    is_running "$name" || fail "Container $name is stopped; use --container start first."
    printf 'Reset %s research to WAKE 0? Prior append-only history and continuity results are preserved. Type %s to continue: ' "$name" "$name" >&2
    IFS= read -r answer
    [[ "$answer" == "$name" ]] || fail 'Reset cancelled.'
    reset_id="$(date +%s)-$$-$RANDOM"
    docker exec "$name" python -c 'import json,os,pathlib,sys; p=pathlib.Path("/data/.wake-runner-control.json"); d=json.loads(p.read_text()) if p.exists() else {}; d["research"]="stopped"; d["reset_id"]=sys.argv[1]; t=p.with_suffix(".tmp"); t.write_text(json.dumps(d)); os.replace(t,p)' "$reset_id" >/dev/null
    for ((attempt=1; attempt<=600; attempt++)); do
        ack="$(docker exec "$name" python -c 'import json,pathlib; p=pathlib.Path("/data/.wake-runner-reset-ack.json"); print(json.dumps(json.loads(p.read_text())) if p.exists() else "")' 2>/dev/null || true)"
        if [[ -n "$ack" && "$ack" == *"\"reset_id\": \"$reset_id\""* ]]; then
            [[ "$ack" == *'"error": null'* ]] || fail "Research reset failed: $ack"
            printf 'Research reset complete at WAKE 0; research is stopped. Use --research start to resume.\n'
            return 0
        fi
        sleep 0.5
    done
    fail 'Research reset is still pending; restart the container once to load the updated runtime, then retry.'
}

research_control() {
    local action="$1" name="$2" campaign="$3" dotfiles="${4:-true}"
    if [[ "$campaign" == false ]] && container_exists "$name"; then
        printf 'wake_runner: --campaign none applies only when creating; existing enrollment is unchanged.\n' >&2
    fi
    case "$action" in
        status)
            report_status "$name"
            return
            ;;
        stop)
            container_exists "$name" || fail "Container does not exist: $name"
            ensure_wake_identity "$name"
            is_running "$name" || fail "Container $name is stopped; use --container start first."
            set_research_mode "$name" stopped
            ;;
        start)
            if container_exists "$name"; then
                ensure_wake_identity "$name"
                is_running "$name" || fail "Container $name is stopped; use --container start first."
                set_research_mode "$name" running
            else
                create_container "$name" "$campaign" false '' '' "$dotfiles"
            fi
            ;;
        pause)
            if ! container_exists "$name"; then create_container "$name" "$campaign" true '' '' "$dotfiles"; fi
            ensure_wake_identity "$name"
            is_running "$name" || fail "Container $name is stopped; use --container start first."
            set_research_mode "$name" paused
            ;;
        reset)
            reset_research "$name" "$campaign"
            ;;
        *) usage >&2; return 2 ;;
    esac
    report_status "$name"
}

container_control() {
    local action="$1" selector="$2" candidate status volume home name data_type group_id
    local targets=() volumes=() groups=()
    while IFS= read -r candidate; do
        if [[ "$candidate" == [0-9][0-9][0-9]."$selector" ||
              "$candidate" == "$selector"-[0-9][0-9][0-9] ]]; then
            targets+=("$candidate")
        fi
    done < <(docker ps -a --filter "label=$LABEL.group=$selector" --format '{{.Names}}')
    if ((${#targets[@]} == 0)) && container_exists "$selector"; then
        targets=("$selector")
    fi
    if ((${#targets[@]} == 0)) && [[ "$action" != remove ]]; then
        fail "No container or numbered group found for '$selector'."
    fi
    if ((${#targets[@]} == 0)) && [[ "$action" == remove ]]; then
        targets=("$selector")
    fi
    for name in "${targets[@]}"; do
        if container_exists "$name"; then
            ensure_wake_identity "$name"
            status="$(docker inspect --format '{{.State.Status}}' "$name")"
            case "$action" in
                stop) [[ "$status" == exited ]] || docker stop --timeout 300 "$name" >/dev/null ;;
                start)
                    if [[ "$status" == paused ]]; then docker unpause "$name" >/dev/null
                    elif [[ "$status" != running ]]; then docker start "$name" >/dev/null; fi
                    ;;
                pause) [[ "$status" != running ]] || docker pause "$name" >/dev/null ;;
                remove)
                    group_id="$(docker inspect --format "{{ index .Config.Labels \"$LABEL.group\" }}" "$name")"
                    [[ -z "$group_id" || "$group_id" == '<no value>' ]] || groups+=("$group_id")
                    data_type="$(docker inspect --format '{{range .Mounts}}{{if eq .Destination "/data"}}{{.Type}}{{end}}{{end}}' "$name")"
                    [[ "$data_type" != bind ]] || fail "Refusing scorched-earth removal of $name: /data is a host bind mount."
                    volume="$(docker inspect --format '{{range .Mounts}}{{if and (eq .Type "volume") (eq .Destination "/data")}}{{.Name}}{{end}}{{end}}' "$name")"
                    home="$(docker inspect --format '{{range .Mounts}}{{if and (eq .Type "volume") (eq .Destination "/home/wake")}}{{.Name}}{{end}}{{end}}' "$name")"
                    [[ -n "$volume" ]] && volumes+=("$volume")
                    [[ -n "$home" ]] && volumes+=("$home")
                    docker rm -f "$name" >/dev/null
                    ;;
            esac
        elif [[ "$action" == remove && "$name" == "$selector" ]]; then
            volumes+=("$(data_volume_for "$name")" "$(home_volume_for "$name")")
        fi
    done
    if [[ "$action" == remove ]]; then
        for volume in "${volumes[@]}"; do
            docker volume inspect "$volume" >/dev/null 2>&1 || continue
            if [[ -z "$(docker ps -a --filter "volume=$volume" --format '{{.Names}}')" ]]; then
                docker volume rm "$volume" >/dev/null
            fi
        done
        if [[ "$selector" != wake ]]; then groups+=("$selector"); fi
        for group_id in "${groups[@]}"; do cleanup_group_network "$group_id"; done
        refresh_group_router
        printf 'Removed %s and unshared attached data volumes.\n' "$selector"
    else
        for name in "${targets[@]}"; do
            printf 'CONTAINER: %s | DOCKER_STATUS: %s\n' "$name" "$(docker inspect --format '{{.State.Status}}' "$name")"
        done
    fi
}

start_group() {
    local prefix="$1" count="$2" campaign="$3" dotfiles="${4:-true}" i name ordinal legacy_name was_existing peers network group_instance
    local new_members=()
    [[ "$prefix" =~ ^[a-zA-Z0-9][a-zA-Z0-9_.-]*$ ]] || fail 'Invalid group name.'
    ((${#prefix} <= 50)) || fail 'Group name must be 50 characters or fewer.'
    [[ "$count" =~ ^[0-9]{1,2}$ ]] || fail 'Count must be a number from 1 to 99.'
    count=$((10#$count))
    (( count >= 1 && count <= 99 )) || fail 'Count must be between 1 and 99.'
    [[ "${CODESPACES:-false}" != true && -z "${CODESPACE_NAME:-}" && "${GITHUB_ACTIONS:-false}" != true && "${CI:-false}" != true ]] ||
        fail 'Grouped peer networking is available only from a local wake_runner session.'
    require_runtime
    ensure_group_network "$prefix"
    peers=""
    for ((i=1; i<=count; i++)); do
        printf -v ordinal '%03d' "$i"
        group_instance="$prefix-$ordinal"
        peers+="${peers:+,}$group_instance"
    done
    for ((i=1; i<=count; i++)); do
        printf -v ordinal '%03d' "$i"
        name="$ordinal.$prefix"
        group_instance="$prefix-$ordinal"
        legacy_name="$prefix-$ordinal"
        if container_exists "$legacy_name"; then
            ensure_wake_identity "$legacy_name"
            [[ "$(docker inspect --format "{{ index .Config.Labels \"$LABEL.group\" }}" "$legacy_name")" == "$prefix" ]] ||
                fail "Legacy container '$legacy_name' is not a member of group '$prefix'; leaving it untouched."
            container_exists "$name" && fail "Both legacy '$legacy_name' and new '$name' containers exist; resolve the name collision before continuing."
            docker rename "$legacy_name" "$name"
            printf 'Renamed container %s to %s without changing its volumes.\n' "$legacy_name" "$name"
        fi
        was_existing=false
        container_exists "$name" && was_existing=true
        ensure_present "$name" "$campaign" "$prefix" "$peers" true "$dotfiles"
        ensure_group_peer_alias "$name" "$prefix" "$group_instance"
        [[ "$was_existing" == true ]] || new_members+=("$name")
        if [[ "$campaign" == false && "$was_existing" == true ]]; then
            printf 'wake_runner: --campaign none applies only when creating; existing enrollment for %s is unchanged.\n' "$name" >&2
        fi
    done
    # Start new group schedulers only after every expected DNS name is present.
    refresh_group_router
    for name in "${new_members[@]}"; do set_research_mode "$name" running; done
    printf 'Add this to /etc/hosts: 127.0.0.1'
    printf ' %s' "$prefix"
    for ((i=1; i<=count; i++)); do
        printf -v name '%s-%03d' "$prefix" "$i"
        printf ' %03d.%s' "$i" "$prefix"
    done
    printf '\n'
    printf 'GROUP PROXY CONTAINER: %s\n' "$GROUP_ROUTER"
    printf 'GROUP PROXY URL: http://%s/\n' "$prefix"
    local lan_ip
    lan_ip="$(host_lan_ipv4 || true)"
    if [[ -n "$lan_ip" ]]; then
        printf 'GROUP PROXY LAN URL: http://%s/\n' "$lan_ip"
    else
        printf 'GROUP PROXY LAN URL: unavailable (could not detect the host IPv4 address)\n'
    fi
    for ((i=1; i<=count; i++)); do
        printf -v ordinal '%03d' "$i"
        name="$ordinal.$prefix"
        printf 'GROUP URL: http://%03d.%s/\n' "$i" "$prefix"
        report_status "$name"
    done
}

main() {
    local name=wake action= campaign=true dotfiles=true count= arg name_set=false
    local explicit_action=false container_action= container_action_set=false
    if (($# == 0)); then
        require_runtime
        ensure_present wake true '' '' false "$dotfiles"
        report_status wake
        return
    fi
    while (($#)); do
        arg="$1"; shift
        case "$arg" in
            --help|-h) usage; return 0 ;;
            --research)
                (($#)) || fail '--research requires stop, start, pause, reset, or status.'
                action="$1"; shift
                case "$action" in stop|start|pause|reset|status) ;; *) fail "Unknown research action: $action" ;; esac
                explicit_action=true
                ;;
            --container)
                (($#)) || fail '--container requires stop, start, pause, or remove.'
                container_action="$1"; shift
                case "$container_action" in stop|start|pause|remove) ;; *) fail "Unknown container action: $container_action" ;; esac
                container_action_set=true
                ;;
            --campaign)
                (($#)) || fail '--campaign requires `none` or `continuity`.'
                case "$1" in
                    none) campaign=false ;;
                    continuity|continuity@1) campaign=true ;;
                    *) fail "Unknown campaign option: $1" ;;
                esac
                shift
                ;;
            --dotfiles)
                if (($#)) && [[ "$1" == true || "$1" == false ]]; then
                    dotfiles="$1"
                    shift
                else
                    dotfiles=true
                fi
                ;;
            --dotfiles=true) dotfiles=true ;;
            --dotfiles=false|--no-dotfiles) dotfiles=false ;;
            --count)
                (($#)) || fail '--count requires a number.'
                count="$1"; shift
                [[ "$count" =~ ^[0-9]+$ ]] || fail '--count requires a positive number.'
                ;;
            --) ;;
            -*) fail "Unknown option: $arg" ;;
            *)
                if [[ "$name_set" == false ]]; then
                    name="$arg"
                    name_set=true
                else
                    fail "Unexpected argument: $arg"
                fi
                ;;
        esac
    done

    if [[ "$explicit_action" == true && "$container_action_set" == true ]]; then
        fail 'Use --research or --container in one invocation, not both.'
    elif [[ -n "$count" && ( "$explicit_action" == true || "$container_action_set" == true ) ]]; then
        fail '--count is only valid when creating or ensuring a named group.'
    elif [[ "$container_action_set" == true ]]; then
        require_runtime
        container_control "$container_action" "$name"
    elif [[ "$explicit_action" == true ]]; then
        require_runtime
        research_control "$action" "$name" "$campaign" "$dotfiles"
    elif [[ -n "$count" ]]; then
        [[ "$name_set" == true ]] || fail 'Provide a group name with --count, for example: scripts/wake_runner wake.local --count 3.'
        start_group "$name" "$count" "$campaign" "$dotfiles"
    else
        require_runtime
        local was_existing=false
        container_exists "$name" && was_existing=true
        ensure_present "$name" "$campaign" '' '' false "$dotfiles"
        if [[ "$campaign" == false && "$was_existing" == true ]]; then
            printf 'wake_runner: --campaign none applies only when creating; existing enrollment is unchanged.\n' >&2
        fi
        report_status "$name"
    fi
}

main "$@"
